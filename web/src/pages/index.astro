---
import BaseLayout from '../layouts/BaseLayout.astro';
import PolicyBarRace from '../components/PolicyBarRace.astro';
import {
  loadManifest,
  loadTrends,
  loadPolicyGraph,
  loadTimelines,
  getPublishedHaoTalks,
  findPublicImage,
  formatIsoDate,
  formatTaipeiTimestamp,
} from '../lib/data';

const manifest = loadManifest();
const trends = loadTrends();
const policyGraph = loadPolicyGraph();
const timelines = loadTimelines();
const allTalks = await getPublishedHaoTalks();
const leadTalk = allTalks[0] ?? null;
const secondaryTalks = allTalks.slice(1, 3);

const portraitSrc = findPublicImage('hao-portrait');
const haoTalksBadgeSrc = findPublicImage('hao-talks-badge');

const startYear = manifest.date_start ? Number(manifest.date_start.slice(0, 4)) : 2001;
const endYear = manifest.date_end ? Number(manifest.date_end.slice(0, 4)) : 2026;
const spanYears = Math.max(1, endYear - startYear + 1);

const top3Heating = [...trends.last_30_days.topics]
  .sort((a, b) => b.delta - a.delta || b.current - a.current)
  .slice(0, 3);

const featuredTimeline =
  (leadTalk?.data.timeline_slug && timelines.find((t) => t.slug === leadTalk.data.timeline_slug)) ||
  timelines.find((t) => t.slug === 'water-pollution-fee') ||
  timelines[0] ||
  null;
---

<BaseLayout title="首頁">
  <!-- 第一幕｜旗艦雜誌雙欄 Hero 舞台 -->
  <section class="relative py-6 sm:py-10 lg:py-14">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
      <!-- 左側 7 欄：溫暖敘事、本站特色《晧哥說》焦點卡、雙行動按鈕、晧哥個人溫度宣言 -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <h1 class="font-serif text-4xl font-bold leading-[1.22] tracking-tight text-emerald-deep sm:text-5xl">
            一萬多篇新聞，<br />不只是新聞。
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600 sm:text-lg">
            從環境部 25 年來的官方新聞出發，為你整理政策演進軌跡。沿著時間、議題與脈絡，看看哪些訊號正在升溫、哪些制度值得繼續追。
          </p>
        </div>

        <!-- 「本站特色 ↳」手繪感彎曲箭頭 + 《晧哥說》焦點特色卡 -->
        <div class="pt-1">
          <div class="mb-2 flex items-center gap-1.5 pl-1 text-xs font-bold tracking-wide text-amber-accent">
            <span>本站特色</span>
            <svg class="h-5 w-6 text-amber-accent" viewBox="0 0 28 22" fill="none">
              <path
                d="M3 3 C 14 3, 18 8, 18 18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path
                d="M13.5 14.5 L 18 19 L 22.5 14.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <div class="rounded-2xl border border-emerald-900/10 bg-gradient-to-br from-[#EDF5F1] to-[#F5F9F7] p-5 shadow-sm sm:p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-start gap-4">
                {haoTalksBadgeSrc && (
                  <img
                    src={haoTalksBadgeSrc}
                    alt="晧哥說"
                    class="h-16 w-auto shrink-0 object-contain drop-shadow-xs sm:h-[72px]"
                  />
                )}
                <div>
                  <div class="text-[11px] font-bold uppercase tracking-[0.16em] text-amber-accent">
                    Featured Insight
                  </div>
                  <div class="mt-0.5 font-serif text-2xl font-bold text-emerald-deep">
                    晧哥說
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-gray-700">
                    從一則新聞，看見一段政策脈絡；從環境變化，理解我們共同的未來。
                  </p>
                </div>
              </div>

              <a
                href="/hao-talks"
                class="inline-flex shrink-0 items-center justify-center rounded-full bg-emerald-deep px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-dark sm:text-sm"
              >
                看看晧哥怎麼說 →
              </a>
            </div>
          </div>
        </div>

        <!-- 雙行動按鈕 -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="#policy-theater"
            class="inline-flex items-center rounded-full bg-emerald-deep px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-dark"
          >
            探索政策脈動
          </a>
          <a
            href="/research"
            class="inline-flex items-center rounded-full border border-emerald-deep/25 bg-white px-6 py-3 text-sm font-semibold text-emerald-deep transition hover:bg-emerald-soft/60"
          >
            閱讀研究觀察
          </a>
        </div>

        <!-- 晧哥個人溫度宣言 -->
        <blockquote class="border-l-[3px] border-emerald-deep pl-4 py-1 text-sm leading-relaxed text-gray-700 sm:text-base">
          「我是晧哥。這裡不替政策打分數，只想把資料整理清楚，陪你多看一層。」
        </blockquote>

        <!-- 低調透明來源註記 -->
        <p class="text-[11px] leading-relaxed text-gray-500">
          資料整理自中華民國環境部官方新聞專區與環境資料開放平臺，本站為獨立政策研究觀察平台，非官方網站。
          <a href="/about" class="ml-1 font-semibold text-emerald-deep underline underline-offset-2">
            資料宣告與免責聲明 →
          </a>
        </p>
      </div>

      <!-- 右側 5 欄：大方展示晧哥半身形象主視覺（透明無黑底、雙層柔和光暈自然融入淺象牙白頁面、呼吸浮動） -->
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="relative flex w-full items-center justify-center py-4">
          <div
            class="pointer-events-none absolute -inset-4 -z-10 rounded-full blur-3xl"
            style="background: radial-gradient(circle at 50% 48%, rgba(16,185,129,0.22) 0%, rgba(15,76,58,0.14) 38%, rgba(245,158,11,0.08) 65%, rgba(248,249,247,0) 82%);"
          ></div>
          <div
            class="pointer-events-none absolute inset-6 -z-10 rounded-full blur-2xl"
            style="background: radial-gradient(circle at 50% 44%, rgba(45,212,191,0.24) 0%, rgba(16,185,129,0.12) 48%, rgba(248,249,247,0) 76%);"
          ></div>

          {portraitSrc ? (
            <img
              src={portraitSrc}
              alt="環策晧脈主筆晧哥形象主視覺"
              class="animate-float-slow max-h-[460px] lg:max-h-[540px] w-auto max-w-full object-contain drop-shadow-[0_20px_36px_rgba(15,76,58,0.18)]"
              style="-webkit-mask-image: linear-gradient(to bottom, black 91%, transparent 100%); mask-image: linear-gradient(to bottom, black 91%, transparent 100%);"
            />
          ) : (
            <div class="flex h-[420px] w-full max-w-sm items-center justify-center rounded-3xl bg-gradient-to-br from-emerald-deep to-emerald-dark font-serif text-7xl font-bold text-amber-200 shadow-lg">
              晧
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 橫幅政策脈搏條 ＋ 4 格大留白無死硬框動態 KPI -->
  <section class="reveal-section mt-4 rounded-3xl border border-emerald-950/[0.06] bg-white px-6 py-7 shadow-[0_8px_30px_rgb(15,76,58,0.05)] sm:px-8 lg:px-10">
    <!-- 政策脈搏帶 -->
    <div class="flex flex-col gap-4 border-b border-emerald-950/[0.08] pb-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex items-center gap-4">
        <svg class="h-8 w-24 shrink-0 text-amber-accent" viewBox="0 0 120 32" fill="none">
          <path
            d="M2 16 H28 L38 5 L48 27 L58 9 L68 21 L76 16 H118"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="pulse-flow-path"
          />
        </svg>
        <div>
          <div class="text-xs font-bold tracking-wide text-emerald-deep">本月政策體溫計</div>
          <div class="text-[11px] text-gray-500">近 30 天聲量升溫最快的 3 個政策訊號</div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        {top3Heating.map((item, idx) => (
          <a
            href={`/topics/${item.slug}`}
            class="inline-flex items-center gap-2 rounded-full border border-emerald-deep/15 bg-ivory px-3.5 py-1.5 text-xs transition hover:border-emerald-deep/40 hover:bg-emerald-soft/70"
          >
            <span class="flex h-4 w-4 items-center justify-center rounded-full bg-emerald-deep text-[10px] font-bold text-white">
              {idx + 1}
            </span>
            <span class="font-semibold text-gray-800">{item.title}</span>
            <span class="font-mono text-[11px] font-semibold text-amber-accent">
              {item.current} 篇 ({item.delta >= 0 ? `+${item.delta}` : item.delta})
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- 4 格大留白動態跳動 KPI（零工程師術語） -->
    <div class="mt-6 grid grid-cols-2 gap-6 lg:grid-cols-4">
      <div>
        <div class="text-xs font-medium text-gray-500">累計收錄官方新聞</div>
        <div class="mt-1.5 font-serif text-3xl font-bold text-emerald-deep sm:text-4xl">
          <span class="count-up" data-target={manifest.total_news}>{manifest.total_news.toLocaleString()}</span>
          <span class="ml-1 text-sm font-normal text-gray-500">篇</span>
        </div>
        <div class="mt-1 text-xs text-gray-500">{manifest.date_start} ～ {manifest.date_end}</div>
      </div>

      <div>
        <div class="text-xs font-medium text-gray-500">橫跨政策觀測年數</div>
        <div class="mt-1.5 font-serif text-3xl font-bold text-emerald-deep sm:text-4xl">
          <span class="count-up" data-target={spanYears}>{spanYears}</span>
          <span class="ml-1 text-sm font-normal text-gray-500">年</span>
        </div>
        <div class="mt-1 text-xs text-gray-500">{startYear}～{endYear} 完整歷程歸檔</div>
      </div>

      <div>
        <div class="text-xs font-medium text-gray-500">已串連政策脈絡</div>
        <div class="mt-1.5 font-serif text-3xl font-bold text-amber-accent sm:text-4xl">
          <span class="count-up" data-target={manifest.total_relation_edges ?? 0}>
            {(manifest.total_relation_edges ?? 0).toLocaleString()}
          </span>
          <span class="ml-1 text-sm font-normal text-gray-500">條</span>
        </div>
        <div class="mt-1 text-xs text-gray-500">自動連結每篇新聞的前世今生</div>
      </div>

      <div>
        <div class="text-xs font-medium text-gray-500">最新資料同步</div>
        <div class="mt-2.5 text-sm font-bold text-gray-800 sm:text-base">
          {formatTaipeiTimestamp(manifest.updated_at)}
        </div>
        <div class="mt-1.5 text-xs text-emerald-deep">每日自動與環境部同步更新</div>
      </div>
    </div>
  </section>

  <!-- 第二幕｜主編焦點：《晧哥說》最新專欄 ＋ 政策演進時間軸 -->
  <section class="reveal-section py-16 lg:py-24">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-accent">Editor's Focus</span>
        <h2 class="mt-1 font-serif text-2xl font-bold text-emerald-deep sm:text-3xl">
          最新《晧哥說》與政策前世今生
        </h2>
      </div>
      <a href="/hao-talks" class="text-sm font-semibold text-emerald-deep hover:underline">
        閱讀全部 {allTalks.length} 篇專欄 →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-7 lg:grid-cols-12">
      <div class="lg:col-span-7 space-y-5">
        {leadTalk ? (
          <a href={`/hao-talks/${leadTalk.id}`} class="editorial-card group block rounded-3xl p-6 sm:p-8">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-amber-soft px-3 py-0.5 font-semibold text-amber-accent">最新把脈</span>
                <span class="font-mono text-gray-500">{formatIsoDate(leadTalk.data.date)}</span>
              </div>
              <span class="font-semibold text-emerald-deep group-hover:underline">閱讀全文 →</span>
            </div>
            <h3 class="mt-3.5 font-serif text-2xl font-bold leading-snug text-gray-900 group-hover:text-emerald-deep">
              {leadTalk.data.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{leadTalk.data.summary}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {leadTalk.data.topics.slice(0, 4).map((t) => (
                <span class="rounded-full bg-emerald-soft px-3 py-0.5 text-xs font-medium text-emerald-deep">{t}</span>
              ))}
            </div>
          </a>
        ) : (
          <div class="editorial-card rounded-3xl p-8 text-center">
            <h3 class="font-serif text-lg font-bold text-emerald-deep">專欄籌備中</h3>
          </div>
        )}

        {secondaryTalks.length > 0 && (
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            {secondaryTalks.map((post) => (
              <a href={`/hao-talks/${post.id}`} class="editorial-card group flex flex-col justify-between rounded-2xl p-5">
                <div>
                  <div class="font-mono text-[11px] text-gray-500">{formatIsoDate(post.data.date)}</div>
                  <h4 class="mt-1.5 font-serif text-base font-bold text-gray-900 group-hover:text-emerald-deep">
                    {post.data.title}
                  </h4>
                  <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-gray-600">{post.data.summary}</p>
                </div>
                <div class="mt-4 text-xs font-semibold text-emerald-deep">閱讀把脈 →</div>
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="lg:col-span-5 rounded-3xl border border-emerald-950/[0.07] bg-white p-6 shadow-[0_8px_30px_rgb(15,76,58,0.05)] sm:p-7">
        <div class="flex items-start justify-between gap-2">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-accent">政策演進時間軸</span>
            <h3 class="mt-0.5 font-serif text-lg font-bold text-emerald-deep">
              {featuredTimeline ? featuredTimeline.title : '重大法規演進'}
            </h3>
          </div>
          <a href="/research#timelines" class="shrink-0 text-xs font-semibold text-emerald-deep hover:underline">
            全部 {timelines.length} 條 →
          </a>
        </div>

        {featuredTimeline && (
          <ol class="mt-5 relative border-l-2 border-emerald-deep/20 pl-5 space-y-5">
            {featuredTimeline.nodes.slice(-5).reverse().map((node) => (
              <li class="relative">
                <span class="absolute -left-[25px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-amber-accent ring-2 ring-emerald-deep/20"></span>
                <div class="flex items-center gap-2 text-[11px]">
                  <span class="font-mono font-semibold text-emerald-deep">{node.date}</span>
                  <span class="rounded-full bg-emerald-soft px-2 py-0.5 font-semibold text-emerald-deep">{node.stage}</span>
                </div>
                <button
                  type="button"
                  data-news-id={node.news_id}
                  data-news-date={node.date}
                  class="open-drawer-trigger mt-1 text-left text-xs font-semibold leading-snug text-gray-900 hover:text-emerald-deep hover:underline"
                >
                  {node.title}
                </button>
              </li>
            ))}
          </ol>
        )}
      </div>
    </div>
  </section>

  <!-- 第三幕 A｜25 年政策脈動動態劇場（可播放動態競賽圖） -->
  <div class="reveal-section pb-16 lg:pb-24">
    <PolicyBarRace idPrefix="home-race" />
  </div>

  <!-- 第三幕 B｜巨觀動態「政策脈絡神經網絡圖」 -->
  <section class="reveal-section mb-16 lg:mb-24 rounded-3xl border border-emerald-950/[0.07] bg-white p-6 shadow-[0_8px_30px_rgb(15,76,58,0.05)] sm:p-8 lg:p-10">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-accent">Macro Policy Neural Map</span>
        <h2 class="mt-1 font-serif text-2xl font-bold text-emerald-deep sm:text-3xl">
          政策脈絡神經網絡圖
        </h2>
        <p class="mt-1.5 text-xs text-gray-600 sm:text-sm">
          滑鼠停留在任一議題上，整條關聯脈絡將隨即點亮聚焦；點擊節點可直接深入該議題 25 年完整檔案。
        </p>
      </div>
      <a
        href="/policy-map"
        class="inline-flex shrink-0 items-center rounded-full border border-emerald-deep/20 bg-ivory px-4 py-2 text-xs font-semibold text-emerald-deep transition hover:bg-emerald-soft"
      >
        開啟全螢幕互動版 ↗
      </a>
    </div>

    <div id="home-macro-graph" class="mt-6 h-[460px] w-full rounded-2xl border border-emerald-950/[0.05] bg-ivory/50"></div>
  </section>

  <!-- 第四幕｜最新環境部新聞快訊 ＋ 微觀局部關聯小星系抽屜 -->
  <section class="reveal-section pb-8">
    <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-accent">Latest Official Signals</span>
        <h2 class="mt-1 font-serif text-2xl font-bold text-emerald-deep sm:text-3xl">最新環境部新聞快訊</h2>
        <p class="mt-1 text-xs text-gray-600 sm:text-sm">
          點擊任一新聞立即展開閱讀抽屜，檢視全文摘要、單篇官網原文與「前世今生」關聯小星系圖。
        </p>
      </div>
      <a href="/news" class="text-sm font-semibold text-emerald-deep hover:underline">
        檢索全量 {manifest.total_news.toLocaleString()} 篇 →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {manifest.latest_news.map((item) => (
        <button
          type="button"
          data-news-id={item.news_id}
          data-news-date={item.date}
          class="open-drawer-trigger editorial-card group flex flex-col justify-between rounded-2xl p-5 text-left"
        >
          <div>
            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
              <span class="font-mono font-semibold text-emerald-deep">{item.date}</span>
              <span>·</span>
              <span>{item.unit}</span>
              {item.policy_keywords.slice(0, 2).map((kw) => (
                <span class="rounded-full bg-emerald-soft px-2.5 py-0.5 text-[11px] font-medium text-emerald-deep">
                  {kw}
                </span>
              ))}
            </div>
            <h3 class="mt-2.5 font-serif text-base font-bold leading-snug text-gray-900 group-hover:text-emerald-deep">
              {item.title}
            </h3>
            {item.summary && (
              <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-gray-600">{item.summary}</p>
            )}
          </div>
          <div class="mt-4 flex items-center justify-between text-[11px] font-semibold text-emerald-deep">
            <span>展開摘要與前世今生小星系 →</span>
            {item.source_url ? (
              <span class="text-gray-400">附單篇官網原文</span>
            ) : (
              <span class="text-amber-accent">官網連結同步中</span>
            )}
          </div>
        </button>
      ))}
    </div>
  </section>

  <script
    id="home-v2-graph-payload"
    type="application/json"
    set:html={JSON.stringify(policyGraph)}
  />

  <script>
    import * as echarts from 'echarts';

    // 1. KPI Count-up animation (respects prefers-reduced-motion)
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.count-up').forEach((el) => {
      const target = Number(el.dataset.target || '0');
      if (reduceMotion || !target) {
        el.textContent = target.toLocaleString();
        return;
      }
      const duration = 950;
      const startTime = performance.now();
      function tick(now: number) {
        const progress = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(target * eased).toLocaleString();
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });

    // 2. Wire all drawer triggers
    document.querySelectorAll<HTMLButtonElement>('.open-drawer-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent('open-news-drawer', {
            detail: { id: btn.dataset.newsId || '', date: btn.dataset.newsDate || '' },
          })
        );
      });
    });

    // 3. Elastic Macro Policy Neural Network Graph with Adjacency Focus & Soft Blur
    const payloadEl = document.getElementById('home-v2-graph-payload');
    const graphEl = document.getElementById('home-macro-graph');

    if (payloadEl && graphEl) {
      const graph = JSON.parse(payloadEl.textContent || '{}');
      const graphChart = echarts.init(graphEl);

      const nodes = (graph.nodes || []).map((n: any) => {
        const isGroup = n.kind === 'group';
        const isTopic = n.kind === 'topic';
        const size = isGroup
          ? 40
          : isTopic
            ? Math.max(17, Math.min(35, 14 + Math.sqrt(n.value || 1) * 0.5))
            : 13;
        return {
          ...n,
          symbolSize: size,
          itemStyle: n.delta30 > 3 ? { shadowBlur: 16, shadowColor: 'rgba(180,83,9,0.5)' } : undefined,
          label: {
            show: isGroup || isTopic,
            fontSize: isGroup ? 12 : 11,
            fontWeight: isGroup ? 'bold' : 'normal',
            color: '#1F2937',
          },
        };
      });

      const links = (graph.links || []).map((l: any) => ({
        ...l,
        lineStyle: {
          width: l.kind === 'hierarchy' ? 2 : Math.max(1.2, Math.min(4.2, (l.weight || 1) / 75)),
          opacity: l.kind === 'hierarchy' ? 0.52 : 0.34,
          curveness: l.kind === 'semantic' ? 0.18 : 0,
        },
      }));

      graphChart.setOption({
        tooltip: {
          trigger: 'item',
          formatter: (p: any) => {
            if (p.dataType === 'edge') {
              return p.data.kind === 'semantic'
                ? `議題脈絡關聯強度：<strong>${p.data.weight}</strong>（共現 ${p.data.cooccurrence || 0} 篇）`
                : '板塊脈絡連線';
            }
            const d = p.data;
            return `<strong>${d.name}</strong><br/>累計收錄：${(d.value || 0).toLocaleString()} 篇<br/>近 30 天：${d.last30 || 0} 篇${d.url ? '<br/><span style="color:#0F4C3A;">點擊深入探索 →</span>' : ''}`;
          },
        },
        legend: { bottom: 8, data: (graph.categories || []).map((c: any) => c.name), textStyle: { fontSize: 11 } },
        series: [
          {
            type: 'graph',
            layout: 'force',
            roam: true,
            draggable: true,
            categories: graph.categories || [],
            data: nodes,
            links,
            force: { repulsion: 280, edgeLength: [55, 135], gravity: 0.11, friction: 0.2 },
            emphasis: {
              focus: 'adjacency',
              scale: true,
              lineStyle: { width: 4, opacity: 0.95 },
            },
            blur: {
              itemStyle: { opacity: 0.16 },
              lineStyle: { opacity: 0.08 },
              label: { opacity: 0.2 },
            },
          },
        ],
      });

      graphChart.on('click', (p: any) => {
        if (p.dataType === 'node' && p.data?.url) {
          window.location.href = p.data.url;
        }
      });

      window.addEventListener('resize', () => graphChart.resize());
    }
  </script>
</BaseLayout>
