---
import BaseLayout from '../layouts/BaseLayout.astro';
import PulseFlowAtlas from '../components/PulseFlowAtlas.astro';
import CitationBox from '../components/CitationBox.astro';
import { loadManifest } from '../lib/data';

const manifest = loadManifest();
---

<BaseLayout
  title="建站幕後與系統架構"
  description="公開環策晧脈（HAO POLICY INTELLIGENCE）從 1.0 到 2.0 的演進歷程、互動中樞流光圖譜、使用的 AI 模型與人機分工宣言。"
>
  <!-- 第一幕｜為什麼要打造環策晧脈？ -->
  <section class="rounded-3xl border border-emerald-950/[0.07] bg-gradient-to-br from-white via-white to-emerald-soft/60 p-7 shadow-[0_8px_30px_rgb(15,76,58,0.05)] sm:p-10">
    <span class="inline-flex rounded-full bg-emerald-soft px-3.5 py-1 text-xs font-semibold text-emerald-deep">
      Behind the Scenes · 建站幕後與系統架構
    </span>
    <h1 class="mt-3 font-serif text-3xl font-bold leading-tight text-emerald-deep sm:text-4xl">
      環策晧脈是怎麼做出來的？
    </h1>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
      過去 25 年，中華民國環境部（與前身環保署）累積發布了超過 <strong>{manifest.total_news.toLocaleString()}</strong> 篇新聞與法規公告。這些資料非常珍貴，卻分散在龐大的網頁海裡，很難一眼看出「這項法規從哪裡來、改了幾次、接下來會怎麼走」。
    </p>
    <p class="mt-3 max-w-3xl text-base leading-relaxed text-gray-600">
      因此我們嘗試用「<strong class="text-emerald-deep">人機協作</strong>」的方式打造環策晧脈——把枯燥的資料整理、分類統計與脈絡串連交給全自動管線與 AI，把思考、把脈與把關留給人，讓這座網站成為透明、可檢驗、永久零伺服器負擔的台灣環境政策觀測站。
    </p>
  </section>

  <!-- 第二幕｜系統演進雙世代對照（1.0 → 2.0） -->
  <section class="reveal-section py-14 lg:py-20">
    <div class="mb-6">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-accent">Evolution · 1.0 → 2.0</span>
      <h2 class="mt-1 font-serif text-2xl font-bold text-emerald-deep sm:text-3xl">
        系統演進雙世代對照
      </h2>
      <p class="mt-1 text-sm text-gray-600">從手動爬蟲的探索期，走向雲端全自動運作的智庫世代</p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- 1.0 探索期 -->
      <div class="rounded-3xl border border-gray-200 bg-white/80 p-6 shadow-xs sm:p-8">
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-bold text-gray-600">1.0 探索期</span>
          <span class="text-xs text-gray-400">手動整理世代</span>
        </div>
        <h3 class="mt-3 font-serif text-xl font-bold text-gray-800">驗證理念的初代工作流</h3>
        <div class="mt-4 flex flex-wrap gap-1.5 text-xs">
          <span class="rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-700">Obsidian 知識庫雛形</span>
          <span class="rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-700">ChatGPT / Codex 爬蟲</span>
          <span class="rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-700">Google Drive 雙向同步</span>
          <span class="rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-700">chatgpt.site 初代發布</span>
        </div>
        <ul class="mt-5 space-y-2 text-sm leading-relaxed text-gray-600 list-disc pl-5">
          <li>成功驗證將環境部歷年新聞轉為結構化知識庫與《晧哥說》評論的價值。</li>
          <li>但網頁爬蟲容易受官網改版與反爬蟲驗證影響，需仰賴本機人工補抓與維護。</li>
          <li>上萬筆 Markdown 檔在雲端硬碟雙向同步容易產生鎖定與版本衝突。</li>
        </ul>
      </div>

      <!-- 2.0 全自動智庫世代 -->
      <div class="rounded-3xl border border-emerald-deep/20 bg-gradient-to-br from-[#EDF5F1] via-white to-[#FAF8F3] p-6 shadow-[0_8px_30px_rgb(15,76,58,0.08)] sm:p-8">
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-emerald-deep px-3 py-1 text-xs font-bold text-white">2.0 全自動智庫世代</span>
          <span class="text-xs font-semibold text-amber-accent">現在的環策晧脈 · 永久 $0</span>
        </div>
        <h3 class="mt-3 font-serif text-xl font-bold text-emerald-deep">全自動每日更新與語意脈絡平台</h3>
        <div class="mt-4 flex flex-wrap gap-1.5 text-xs">
          <span class="rounded-full bg-emerald-soft px-3 py-1 font-semibold text-emerald-deep">環境部開放資料 MNEWS_P_01</span>
          <span class="rounded-full bg-emerald-soft px-3 py-1 font-semibold text-emerald-deep">GitHub Actions 每日排程</span>
          <span class="rounded-full bg-amber-soft px-3 py-1 font-semibold text-amber-accent">Gemini 語意與架構設計</span>
          <span class="rounded-full bg-amber-soft px-3 py-1 font-semibold text-amber-accent">Google Antigravity 工程開發</span>
          <span class="rounded-full bg-emerald-soft px-3 py-1 font-semibold text-emerald-deep">Obsidian Git 寫作把脈</span>
          <span class="rounded-full bg-emerald-soft px-3 py-1 font-semibold text-emerald-deep">Astro + Cloudflare Pages</span>
        </div>
        <ul class="mt-5 space-y-2 text-sm leading-relaxed text-gray-700 list-disc pl-5">
          <li>改以官方 Open Data API 每日自動增量同步，並精準配對單篇官網原文。</li>
          <li>建置 56,000+ 條新聞關聯邊與雙層互動關聯圖，讓每一則新聞都能看見前世今生。</li>
          <li>全套雲端排程、靜態託管與 AI 免費層自動降級機制，達成永久零伺服器月費。</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 第三幕｜環策晧脈中樞流光圖譜（HAO PULSE FLOW ATLAS） -->
  <section class="reveal-section mb-16">
    <div class="mb-5">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-accent">Interactive Telemetry Atlas</span>
      <h2 class="mt-1 font-serif text-2xl font-bold text-emerald-deep sm:text-3xl">
        環策晧脈中樞流光圖譜
      </h2>
      <p class="mt-1.5 text-sm text-gray-600">
        切換 <strong>FLOWS</strong>（資料流光弧線）、<strong>ARCS</strong>（AI 模型 × 系統模組神經星芒網）與 <strong>LOGS</strong>（真實同步遙測紀錄），直覺看見每天早上資料如何從環境部流向你的螢幕。
      </p>
    </div>

    <PulseFlowAtlas />
  </section>

  <!-- 第四幕｜AI 與人類的分工宣言 -->
  <section class="reveal-section mb-12">
    <div class="mb-6">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-accent">Human × AI Philosophy</span>
      <h2 class="mt-1 font-serif text-2xl font-bold text-emerald-deep sm:text-3xl">
        AI 與人類的分工宣言
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-emerald-950/[0.07] bg-white p-6 shadow-[0_8px_30px_rgb(15,76,58,0.05)] sm:p-8">
        <div class="inline-flex rounded-full bg-emerald-soft px-3 py-1 text-xs font-bold text-emerald-deep">
          AI 與自動化擅長的事
        </div>
        <h3 class="mt-3 font-serif text-xl font-bold text-gray-900">把繁重、重複、需要全量記憶的工作做到極致</h3>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-gray-600 list-disc pl-5">
          <li>每天早上 08:00 不喊累地讀完環境部最新公告，完成清洗與去重。</li>
          <li>幾秒鐘內算完 25 年、20 大議題的歷年聲量變化與近 30 天升溫指標。</li>
          <li>從 {manifest.total_news.toLocaleString()} 篇新聞裡自動串連超過 {(manifest.total_relation_edges ?? 56000).toLocaleString()} 條語意脈絡，讓任何一篇新公告都能馬上看見前世今生。</li>
        </ul>
      </div>

      <div class="rounded-3xl border border-amber-accent/20 bg-gradient-to-br from-[#FFFDF7] to-white p-6 shadow-[0_8px_30px_rgb(180,83,9,0.06)] sm:p-8">
        <div class="inline-flex rounded-full bg-amber-soft px-3 py-1 text-xs font-bold text-amber-accent">
          晧哥堅持自己做的事
        </div>
        <h3 class="mt-3 font-serif text-xl font-bold text-emerald-deep">把現場經驗、脈絡判斷與公共溫度留在文章裡</h3>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-gray-700 list-disc pl-5">
          <li>從候選雷達裡親自挑出真正影響台灣環境、企業合規與民眾日常的關鍵題目。</li>
          <li>用實務現場經驗為政策「把脈、把關」，點出公告背後容易被忽略的盲點與配套缺口。</li>
          <li>親手寫下每一篇有觀點、有溫度的《晧哥說》，不替政策打分數，只陪你多看一層。</li>
        </ul>
      </div>
    </div>
  </section>

  <CitationBox title="建站幕後：環策晧脈（HAO POLICY INTELLIGENCE）人機協作與全自動觀測架構" year="2026" />
</BaseLayout>
