---
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import CitationBox from '../components/CitationBox.astro';
import {
  loadResearch,
  loadTimelines,
  loadMethodology,
  formatTaipeiTimestamp,
} from '../lib/data';

const research = loadResearch();
const timelines = loadTimelines();
const methodology = loadMethodology();

const renderedReports = research.reports.map((rep) => ({
  ...rep,
  html: marked.parse(rep.body_markdown) as string,
}));
---

<BaseLayout
  title="學術研究專區"
  description="環策皓脈學術研究專區：政策演進法規時間軸、研究級 CSV/JSON 開放下載、標準學術引用格式、分類口徑與路線 3 關聯演算法公開。"
>
  <div class="mb-8">
    <span class="inline-flex rounded-full bg-emerald-soft px-3 py-1 text-xs font-semibold text-emerald-deep">
      Academic Research Hub · 開放研究基礎設施
    </span>
    <h1 class="mt-2 font-serif text-3xl font-bold text-emerald-deep">學術研究專區</h1>
    <p class="mt-1.5 text-sm text-gray-600">
      提供台灣環境政策 25 年法規演進時間軸、UTF-8 統計資料開放下載、標準學術引用格式、透明分類口徑與 {research.report_count} 篇深度研究報告。
    </p>
    <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
      <a href="#timelines" class="rounded-full border border-emerald-deep/20 bg-white px-3 py-1.5 text-emerald-deep hover:bg-emerald-soft">① 法規演進時間軸</a>
      <a href="#downloads" class="rounded-full border border-emerald-deep/20 bg-white px-3 py-1.5 text-emerald-deep hover:bg-emerald-soft">② 研究資料開放下載</a>
      <a href="#citation" class="rounded-full border border-emerald-deep/20 bg-white px-3 py-1.5 text-emerald-deep hover:bg-emerald-soft">③ 標準學術引用</a>
      <a href="#methodology" class="rounded-full border border-emerald-deep/20 bg-white px-3 py-1.5 text-emerald-deep hover:bg-emerald-soft">④ 分類口徑與演算法</a>
      <a href="#reports" class="rounded-full border border-emerald-deep/20 bg-white px-3 py-1.5 text-emerald-deep hover:bg-emerald-soft">深度研究報告 ({research.report_count})</a>
    </div>
  </div>

  <!-- ① 政策演進「法規時間軸」模組 -->
  <section id="timelines" class="mb-10 rounded-3xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-accent">Pillar 01 · Policy Evolution Timelines</span>
        <h2 class="mt-0.5 font-serif text-2xl font-bold text-emerald-deep">政策演進「法規時間軸」</h2>
        <p class="mt-1 text-xs text-gray-500">
          自動從 {methodology.coverage.total_news.toLocaleString()} 篇歷史新聞彙整「預告 → 研商 → 修正發布 → 施行」關鍵節點，每筆直達環境部單篇原文。
        </p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap gap-2" id="timeline-tabs">
      {timelines.map((tl, idx) => (
        <button
          type="button"
          data-tl-slug={tl.slug}
          class:list={[
            'tl-tab-btn rounded-xl border px-3.5 py-2 text-xs font-semibold transition',
            idx === 0
              ? 'border-emerald-deep bg-emerald-deep text-white'
              : 'border-gray-200 bg-ivory text-gray-700 hover:border-emerald-deep/40 hover:text-emerald-deep',
          ]}
        >
          {tl.title}（{tl.nodes.length}）
        </button>
      ))}
    </div>

    <div class="mt-6">
      {timelines.map((tl, idx) => (
        <div
          data-tl-panel={tl.slug}
          class:list={['tl-panel', idx === 0 ? '' : 'hidden']}
        >
          <div class="mb-4 rounded-xl bg-ivory p-4 text-xs text-gray-600">
            <strong class="text-emerald-deep">{tl.title}</strong>：{tl.description}
            <span class="ml-2 text-gray-400">（全庫累計命中 {tl.total_matched} 篇，精選 {tl.nodes.length} 個關鍵演進節點）</span>
          </div>

          <ol class="relative border-l-2 border-emerald-deep/20 pl-6 space-y-5">
            {tl.nodes.map((node) => (
              <li class="relative">
                <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-amber-accent ring-2 ring-emerald-deep/25"></span>
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="font-mono font-bold text-emerald-deep">{node.date}</span>
                  <span class="rounded-full bg-emerald-soft px-2.5 py-0.5 text-[11px] font-semibold text-emerald-deep">
                    {node.stage}
                  </span>
                  <span class="text-gray-500">{node.unit}</span>
                </div>
                <div class="mt-1 flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    data-news-id={node.news_id}
                    data-news-date={node.date}
                    class="tl-open-drawer text-left font-serif text-base font-bold text-gray-900 hover:text-emerald-deep hover:underline"
                  >
                    {node.title}
                  </button>
                  {node.source_url && (
                    <a
                      href={node.source_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded border border-gray-200 px-2 py-0.5 text-[11px] font-medium text-emerald-deep hover:bg-emerald-soft"
                    >
                      官網原文 ↗
                    </a>
                  )}
                </div>
                {node.summary && (
                  <p class="mt-1 text-xs leading-relaxed text-gray-600">{node.summary}</p>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- ② 研究級統計資料開放下載區 -->
  <section id="downloads" class="mb-10 rounded-3xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <span class="text-xs font-bold uppercase tracking-wider text-amber-accent">Pillar 02 · Open Research Datasets</span>
    <h2 class="mt-0.5 font-serif text-2xl font-bold text-emerald-deep">研究級統計資料開放下載</h2>
    <p class="mt-1 text-xs text-gray-600">
      資料涵蓋期間：<strong>{methodology.coverage.date_start} ～ {methodology.coverage.date_end}</strong>（共 {methodology.coverage.total_news.toLocaleString()} 篇）｜
      最後更新：{formatTaipeiTimestamp(methodology.updated_at)}｜
      版本指紋（SHA-256）：<code class="rounded bg-ivory px-1.5 py-0.5 font-mono text-[11px] text-emerald-deep">{methodology.dataset_version}</code>
    </p>

    <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-3">
      <a
        href="/data/downloads/moenv_topic_yearly_matrix.csv"
        download="moenv_topic_yearly_matrix.csv"
        class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-ivory/70 p-5 transition hover:border-emerald-deep/40 hover:bg-white hover:shadow-sm"
      >
        <div>
          <span class="rounded bg-emerald-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-emerald-deep">CSV (UTF-8 BOM)</span>
          <h3 class="mt-2 font-serif text-base font-bold text-gray-900 group-hover:text-emerald-deep">
            歷年 20 大政策議題聲量矩陣
          </h3>
          <p class="mt-1 text-xs leading-relaxed text-gray-600">
            2001～2026 各年度總新聞數與 20 大議題逐年筆數，Excel 開啟零亂碼。
          </p>
        </div>
        <div class="mt-4 text-xs font-semibold text-emerald-deep">下載 moenv_topic_yearly_matrix.csv ↓</div>
      </a>

      <a
        href="/data/downloads/moenv_unit_yearly_stats.csv"
        download="moenv_unit_yearly_stats.csv"
        class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-ivory/70 p-5 transition hover:border-emerald-deep/40 hover:bg-white hover:shadow-sm"
      >
        <div>
          <span class="rounded bg-emerald-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-emerald-deep">CSV (UTF-8 BOM)</span>
          <h3 class="mt-2 font-serif text-base font-bold text-gray-900 group-hover:text-emerald-deep">
            環境部各司署歷年發布量統計
          </h3>
          <p class="mt-1 text-xs leading-relaxed text-gray-600">
            前 40 大發布司署／單位自 2001 年起逐年發布量與歷年累計統計表。
          </p>
        </div>
        <div class="mt-4 text-xs font-semibold text-emerald-deep">下載 moenv_unit_yearly_stats.csv ↓</div>
      </a>

      <a
        href="/data/downloads/moenv_methodology_metadata.json"
        download="moenv_methodology_metadata.json"
        class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-ivory/70 p-5 transition hover:border-emerald-deep/40 hover:bg-white hover:shadow-sm"
      >
        <div>
          <span class="rounded bg-amber-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-amber-accent">JSON Metadata</span>
          <h3 class="mt-2 font-serif text-base font-bold text-gray-900 group-hover:text-emerald-deep">
            研究口徑、同義詞表與 SHA-256 指紋
          </h3>
          <p class="mt-1 text-xs leading-relaxed text-gray-600">
            完整紀錄 20 大議題同義詞規則、去重演算法與路線 3 關聯引擎參數，支援論文可重現性。
          </p>
        </div>
        <div class="mt-4 text-xs font-semibold text-emerald-deep">下載 moenv_methodology_metadata.json ↓</div>
      </a>
    </div>
  </section>

  <!-- ③ 一鍵複製標準學術引用格式 -->
  <div id="citation" class="mb-10">
    <CitationBox title="台灣環境部歷年政策新聞資料庫與 20 大議題長期趨勢統計（2001–2026）" year="2026" />
  </div>

  <!-- ④ 分類口徑與路線 3 關聯演算法公開（Methodology） -->
  <section id="methodology" class="mb-10 rounded-3xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <span class="text-xs font-bold uppercase tracking-wider text-amber-accent">Pillar 04 · Transparent Methodology</span>
    <h2 class="mt-0.5 font-serif text-2xl font-bold text-emerald-deep">分類口徑與路線 3 關聯演算法公開</h2>

    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 text-xs leading-relaxed text-gray-700">
      <div class="rounded-xl bg-ivory p-4">
        <div class="font-bold text-emerald-deep">去重與一文多標籤口徑</div>
        <p class="mt-1.5">{methodology.deduplication}</p>
        <p class="mt-2">{methodology.multi_label_rule}</p>
      </div>
      <div class="rounded-xl bg-ivory p-4">
        <div class="font-bold text-emerald-deep">{methodology.relation_engine.name}</div>
        <p class="mt-1.5"><strong>第一層：</strong>{methodology.relation_engine.layer_1}</p>
        <p class="mt-1.5"><strong>第二層：</strong>{methodology.relation_engine.layer_2}</p>
        <p class="mt-1.5 font-mono text-[11px] text-emerald-deep">{methodology.relation_engine.blend_formula}</p>
      </div>
    </div>

    <details class="mt-5 rounded-xl border border-gray-200 bg-ivory/50 p-4">
      <summary class="cursor-pointer text-xs font-bold text-emerald-deep">
        展開檢視全部 20 大政策議題同義詞規則表（{methodology.topic_profiles.length} 項）▾
      </summary>
      <div class="mt-3 overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-xs">
          <thead>
            <tr class="bg-white text-left font-semibold text-gray-600">
              <th class="px-3 py-2">議題</th>
              <th class="px-3 py-2">群組</th>
              <th class="px-3 py-2">同義詞規則</th>
              <th class="px-3 py-2 text-right">累計命中</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            {methodology.topic_profiles.map((p) => (
              <tr>
                <td class="px-3 py-2 font-semibold text-emerald-deep">{p.title}</td>
                <td class="px-3 py-2 text-gray-500">{p.group}</td>
                <td class="px-3 py-2 text-gray-700">{p.aliases.join('、')}</td>
                <td class="px-3 py-2 text-right font-mono">{p.total_count.toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <!-- 結構化 v2 資料集互動圖表 -->
  {research.datasets.length > 0 && (
    <section class="mb-10">
      <h2 class="mb-4 font-serif text-2xl font-bold text-emerald-deep">
        結構化政策研究統計圖表（v2 資料集）
      </h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {research.datasets.map((ds, idx) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-full bg-emerald-soft px-2.5 py-0.5 text-xs font-semibold text-emerald-deep">
                {ds.research_id}
              </span>
              <span class="text-xs text-gray-500">
                涵蓋：{ds.scope?.date_from} ～ {ds.scope?.date_to}
              </span>
            </div>
            <h3 class="mt-2 font-serif text-xl font-bold text-gray-900">
              {ds.topic?.name_zh || ds.research_id}
            </h3>
            <p class="mt-1 text-xs leading-relaxed text-gray-600">
              {ds.topic?.description}
            </p>
            <div class="mt-3 flex flex-wrap gap-4 text-xs text-gray-600">
              <span>總新聞數：<strong class="text-emerald-deep">{ds.statistics?.total_articles ?? ds.scope?.article_count ?? 0}</strong> 篇</span>
              {ds.statistics?.peak_year && (
                <span>高峰年份：<strong class="text-amber-accent">{ds.statistics.peak_year.year}</strong>（{ds.statistics.peak_year.count} 篇）</span>
              )}
            </div>
            <div id={`research-chart-${idx}`} class="mt-4 h-[280px] w-full"></div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 深度政策研究報告列表 -->
  <section id="reports">
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="font-serif text-2xl font-bold text-emerald-deep">
        深度研究報告（{renderedReports.length} 篇）
      </h2>
      <input
        id="research-filter"
        type="search"
        placeholder="篩選研究主題或關鍵字..."
        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-emerald-deep focus:outline-none sm:w-64"
      />
    </div>

    <div class="space-y-4" id="research-report-list">
      {renderedReports.map((rep) => (
        <details
          id={rep.slug}
          data-search={`${rep.topic} ${rep.issue_type} ${rep.aliases.join(' ')} ${rep.summary}`.toLowerCase()}
          class="research-card group rounded-2xl border border-gray-200 bg-white shadow-sm open:border-emerald-deep/40"
        >
          <summary class="cursor-pointer list-none p-5 sm:p-6">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-emerald-soft px-2.5 py-0.5 text-xs font-semibold text-emerald-deep">
                  {rep.issue_type || '政策研究'}
                </span>
                <h3 class="font-serif text-lg font-bold text-gray-900 group-hover:text-emerald-deep">
                  {rep.topic}
                </h3>
              </div>
              <span class="text-xs font-mono text-gray-500">
                涵蓋 {rep.coverage_start} ～ {rep.coverage_end || rep.updated}
              </span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{rep.summary}</p>
            <div class="mt-3 flex items-center justify-between text-xs">
              <div class="flex flex-wrap gap-1.5">
                {rep.aliases.slice(0, 6).map((a) => (
                  <span class="rounded bg-ivory px-2 py-0.5 text-gray-600">{a}</span>
                ))}
              </div>
              <span class="font-semibold text-emerald-deep shrink-0 ml-2">展開全文 ▾</span>
            </div>
          </summary>

          <div class="border-t border-gray-100 px-5 py-6 sm:px-8">
            <div class="prose-editorial" set:html={rep.html} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <script
    id="research-datasets-payload"
    type="application/json"
    set:html={JSON.stringify(research.datasets)}
  />

  <script>
    import * as echarts from 'echarts';

    // Timeline tab switching
    const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.tl-tab-btn'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.tl-panel'));
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.tlSlug;
        tabBtns.forEach((b) => {
          b.classList.remove('border-emerald-deep', 'bg-emerald-deep', 'text-white');
          b.classList.add('border-gray-200', 'bg-ivory', 'text-gray-700');
        });
        btn.classList.add('border-emerald-deep', 'bg-emerald-deep', 'text-white');
        btn.classList.remove('border-gray-200', 'bg-ivory', 'text-gray-700');
        panels.forEach((p) => p.classList.toggle('hidden', p.dataset.tlPanel !== slug));
      });
    });

    // Open NewsDetailDrawer from timeline nodes
    document.querySelectorAll<HTMLButtonElement>('.tl-open-drawer').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent('open-news-drawer', {
            detail: { id: btn.dataset.newsId || '', date: btn.dataset.newsDate || '' },
          })
        );
      });
    });

    // v2 dataset charts
    const payloadEl = document.getElementById('research-datasets-payload');
    if (payloadEl) {
      const datasets = JSON.parse(payloadEl.textContent || '[]');
      const charts: echarts.ECharts[] = [];
      datasets.forEach((ds: any, idx: number) => {
        const el = document.getElementById(`research-chart-${idx}`);
        const series = (ds.trend_series || [])[0];
        if (!el || !series) return;
        const points = series.points || [];
        const chart = echarts.init(el);
        chart.setOption({
          tooltip: { trigger: 'axis' },
          grid: { left: 42, right: 16, top: 16, bottom: 28 },
          xAxis: { type: 'category', data: points.map((p: any) => p.period), axisLabel: { color: '#4B5563', fontSize: 11 } },
          yAxis: { type: 'value', splitLine: { lineStyle: { color: '#F3F4F6' } } },
          series: [
            {
              name: series.label || '年度新聞數',
              type: 'line',
              smooth: true,
              data: points.map((p: any) => p.value),
              lineStyle: { width: 2.5, color: idx % 2 === 0 ? '#0F4C3A' : '#B45309' },
              itemStyle: { color: idx % 2 === 0 ? '#0F4C3A' : '#B45309' },
              areaStyle: { opacity: 0.14 },
            },
          ],
        });
        charts.push(chart);
      });
      window.addEventListener('resize', () => charts.forEach((c) => c.resize()));
    }

    // Filter reports
    const filterInput = document.getElementById('research-filter') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.research-card'));
    filterInput?.addEventListener('input', () => {
      const q = (filterInput.value || '').trim().toLowerCase();
      cards.forEach((card) => {
        const hay = card.dataset.search || '';
        card.classList.toggle('hidden', Boolean(q && !hay.includes(q)));
      });
    });

    if (window.location.hash) {
      const target = document.getElementById(window.location.hash.slice(1)) as HTMLDetailsElement | null;
      if (target && target.tagName === 'DETAILS') {
        target.open = true;
        target.scrollIntoView({ behavior: 'smooth' });
      }
    }
  </script>
</BaseLayout>
