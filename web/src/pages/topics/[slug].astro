---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  loadTopics,
  loadResearch,
  getPublishedHaoTalks,
  formatIsoDate,
  type TopicData,
} from '../../lib/data';

export function getStaticPaths() {
  const topics = loadTopics();
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: TopicData;
}

const { topic } = Astro.props;
const research = loadResearch();
const relatedReports = research.reports.filter(
  (r) => r.keywords.includes(topic.slug) || r.topic.includes(topic.title)
);

const allTalks = await getPublishedHaoTalks();
const relatedTalks = allTalks.filter(
  (t) => t.data.topics.includes(topic.title) || t.data.topics.includes(topic.slug)
);

const years = Object.keys(topic.yearly_counts).sort();
const counts = years.map((y) => topic.yearly_counts[y] ?? 0);
---

<BaseLayout title={`${topic.title} — 政策議題專頁`} description={topic.description}>
  <div class="mb-6">
    <a href="/topics" class="text-xs font-semibold text-emerald-deep hover:underline">
      ← 返回政策議題總覽
    </a>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-emerald-soft px-3 py-1 text-xs font-semibold text-emerald-deep">
        {topic.group}
      </span>
      <span class="rounded-full bg-amber-soft px-3 py-1 text-xs font-semibold text-amber-accent">
        累計 {topic.total_count.toLocaleString()} 篇
      </span>
      <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700">
        近 30 天 {topic.last_30_days_count} 篇
      </span>
    </div>
    <h1 class="mt-2 font-serif text-3xl font-bold text-emerald-deep">{topic.title}</h1>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-gray-600">{topic.description}</p>

    <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs">
      <span class="font-semibold text-gray-500">檢索同義詞：</span>
      {topic.aliases.map((alias) => (
        <span class="rounded border border-gray-200 bg-white px-2 py-0.5 text-gray-700">
          {alias}
        </span>
      ))}
    </div>
  </div>

  <!-- 2001~2026 專屬走勢圖 -->
  <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="font-serif text-xl font-bold text-emerald-deep">2001～2026 歷年聲量走勢</h2>
    <div id="topic-yearly-chart" class="mt-4 h-[320px] w-full"></div>
  </section>

  <!-- 對應政策研究 & 皓哥說 -->
  {(relatedReports.length > 0 || relatedTalks.length > 0) && (
    <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {relatedReports.length > 0 && (
        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="font-serif text-lg font-bold text-emerald-deep">對應政策研究報告</h2>
          <div class="mt-3 space-y-3">
            {relatedReports.map((rep) => (
              <a
                href={`/research#${rep.slug}`}
                class="block rounded-lg border border-gray-100 bg-ivory p-3.5 transition hover:border-emerald-deep/40"
              >
                <div class="flex items-center justify-between text-xs text-gray-500">
                  <span>{rep.issue_type || '政策研究'}</span>
                  <span>涵蓋至 {rep.coverage_end || rep.updated}</span>
                </div>
                <div class="mt-1 font-semibold text-emerald-deep">{rep.topic}</div>
                <p class="mt-1 line-clamp-2 text-xs text-gray-600">{rep.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {relatedTalks.length > 0 && (
        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="font-serif text-lg font-bold text-emerald-deep">相關《皓哥說》專欄</h2>
          <div class="mt-3 space-y-3">
            {relatedTalks.map((talk) => (
              <a
                href={`/hao-talks/${talk.id}`}
                class="block rounded-lg border border-gray-100 bg-ivory p-3.5 transition hover:border-emerald-deep/40"
              >
                <div class="text-xs text-gray-500">{formatIsoDate(talk.data.date)}</div>
                <div class="mt-1 font-semibold text-emerald-deep">{talk.data.title}</div>
                <p class="mt-1 line-clamp-2 text-xs text-gray-600">{talk.data.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  )}

  <!-- 該議題完整歷史新聞分頁清單 -->
  <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-serif text-xl font-bold text-emerald-deep">完整歷史新聞檔案</h2>
        <p class="text-xs text-gray-500" id="topic-news-status">
          正在載入「{topic.title}」完整清單...
        </p>
      </div>
      <input
        id="topic-news-filter"
        type="search"
        placeholder="在此議題內篩選關鍵字..."
        class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-emerald-deep focus:outline-none sm:w-64"
      />
    </div>

    <div id="topic-news-list" class="mt-4 divide-y divide-gray-100"></div>

    <div class="mt-5 flex items-center justify-between border-t border-gray-100 pt-4 text-xs">
      <button
        id="topic-prev-btn"
        type="button"
        class="rounded-md border border-gray-300 px-3 py-1.5 font-medium text-gray-700 disabled:opacity-40"
      >
        上一頁
      </button>
      <span id="topic-page-info" class="text-gray-600"></span>
      <button
        id="topic-next-btn"
        type="button"
        class="rounded-md border border-gray-300 px-3 py-1.5 font-medium text-gray-700 disabled:opacity-40"
      >
        下一頁
      </button>
    </div>
  </section>

  <!-- 側邊閱讀抽屜 -->
  <div id="topic-drawer-backdrop" class="fixed inset-0 z-50 hidden bg-black/40 backdrop-blur-[1px]"></div>
  <aside
    id="topic-drawer"
    class="fixed right-0 top-0 z-50 hidden h-full w-full max-w-xl overflow-y-auto bg-white p-6 shadow-2xl"
    aria-label="新聞詳情"
  >
    <div class="flex items-center justify-between border-b border-gray-200 pb-3">
      <span class="text-xs font-semibold text-emerald-deep">新聞詳情</span>
      <button id="topic-drawer-close" type="button" class="rounded-md p-1.5 text-gray-500 hover:bg-gray-100">✕</button>
    </div>
    <div id="topic-drawer-content" class="mt-4"></div>
  </aside>

  <script
    id="topic-page-payload"
    type="application/json"
    set:html={JSON.stringify({ slug: topic.slug, title: topic.title, years, counts })}
  />

  <script>
    import * as echarts from 'echarts';

    const payloadEl = document.getElementById('topic-page-payload');
    const chartEl = document.getElementById('topic-yearly-chart');

    if (payloadEl && chartEl) {
      const { slug, years, counts } = JSON.parse(payloadEl.textContent || '{}');
      const chart = echarts.init(chartEl);
      chart.setOption({
        tooltip: { trigger: 'axis' },
        grid: { left: 48, right: 20, top: 16, bottom: 32 },
        xAxis: { type: 'category', data: years, axisLabel: { color: '#4B5563' } },
        yAxis: { type: 'value', splitLine: { lineStyle: { color: '#F3F4F6' } } },
        series: [
          {
            type: 'bar',
            data: counts,
            itemStyle: { color: '#0F4C3A', borderRadius: [4, 4, 0, 0] },
          },
        ],
      });
      window.addEventListener('resize', () => chart.resize());

      const listEl = document.getElementById('topic-news-list');
      const statusEl = document.getElementById('topic-news-status');
      const filterEl = document.getElementById('topic-news-filter') as HTMLInputElement | null;
      const prevBtn = document.getElementById('topic-prev-btn') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('topic-next-btn') as HTMLButtonElement | null;
      const pageInfoEl = document.getElementById('topic-page-info');
      const drawer = document.getElementById('topic-drawer');
      const backdrop = document.getElementById('topic-drawer-backdrop');
      const drawerContent = document.getElementById('topic-drawer-content');
      const drawerClose = document.getElementById('topic-drawer-close');

      const yearCache = new Map<string, any[]>();
      let allItems: any[] = [];
      let filtered: any[] = [];
      let page = 1;
      const pageSize = 20;

      function closeDrawer() {
        drawer?.classList.add('hidden');
        backdrop?.classList.add('hidden');
      }
      drawerClose?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);

      function openDetail(id: string, date: string) {
        window.dispatchEvent(new CustomEvent('open-news-drawer', { detail: { id, date } }));
      }

      function renderList() {
        if (!listEl || !pageInfoEl || !prevBtn || !nextBtn || !statusEl) return;
        const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
        page = Math.min(page, totalPages);
        const slice = filtered.slice((page - 1) * pageSize, page * pageSize);

        statusEl.textContent = `共 ${filtered.length.toLocaleString()} 篇新聞（點擊任一標題展開完整摘要）`;
        pageInfoEl.textContent = `第 ${page} / ${totalPages} 頁`;
        prevBtn.disabled = page <= 1;
        nextBtn.disabled = page >= totalPages;

        listEl.innerHTML = slice
          .map(
            (item) => `
            <button type="button" data-id="${item.id}" data-date="${item.d}" class="topic-row block w-full py-3 text-left transition hover:bg-ivory px-2 rounded-md">
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <span class="font-mono font-medium text-emerald-deep">${item.d}</span>
                <span>·</span>
                <span>${item.u}</span>
              </div>
              <div class="mt-1 text-sm font-medium text-gray-900">${item.t}</div>
            </button>
          `
          )
          .join('');

        listEl.querySelectorAll<HTMLButtonElement>('.topic-row').forEach((btn) => {
          btn.addEventListener('click', () => {
            openDetail(btn.dataset.id || '', btn.dataset.date || '');
          });
        });
      }

      prevBtn?.addEventListener('click', () => {
        if (page > 1) {
          page -= 1;
          renderList();
        }
      });
      nextBtn?.addEventListener('click', () => {
        page += 1;
        renderList();
      });
      filterEl?.addEventListener('input', () => {
        const q = (filterEl.value || '').trim().toLowerCase();
        filtered = q
          ? allItems.filter(
              (item) =>
                item.t.toLowerCase().includes(q) ||
                item.u.toLowerCase().includes(q) ||
                String(item.id).includes(q)
            )
          : allItems;
        page = 1;
        renderList();
      });

      fetch('/data/search_index.json')
        .then((r) => r.json())
        .then((index: any[]) => {
          allItems = index.filter((item) => Array.isArray(item.k) && item.k.includes(slug));
          filtered = allItems;
          renderList();
        })
        .catch(() => {
          if (statusEl) statusEl.textContent = '載入新聞索引失敗。';
        });
    }
  </script>
</BaseLayout>
