---
import BaseLayout from '../layouts/BaseLayout.astro';
import CitationBox from '../components/CitationBox.astro';
import { findPublicImage, loadManifest } from '../lib/data';

const portraitSrc = findPublicImage('hao-portrait');
const manifest = loadManifest();
---

<BaseLayout
  title="關於與宣告"
  description="關於環策晧脈（Taiwan Environment Observatory）：品牌理念、政府開放資料授權宣告、智慧財產權歸屬與獨立免責聲明。"
>
  <div class="mx-auto max-w-4xl space-y-8">
    <!-- 品牌緣起與理念 -->
    <section class="rounded-3xl border border-emerald-900/15 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        {portraitSrc ? (
          <img
            src={portraitSrc}
            alt="環策晧脈主筆形象照"
            class="h-28 w-28 shrink-0 rounded-2xl bg-gradient-to-b from-emerald-soft/75 to-ivory object-cover object-top ring-2 ring-emerald-deep/20 shadow-xs"
          />
        ) : (
          <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-deep to-emerald-dark font-serif text-4xl font-bold text-amber-200 shadow-inner">
            晧
          </div>
        )}
        <div>
          <span class="rounded-full bg-emerald-soft px-3 py-1 text-xs font-semibold text-emerald-deep">
            About · Taiwan Environment Observatory
          </span>
          <h1 class="mt-2 font-serif text-3xl font-bold text-emerald-deep">關於環策晧脈</h1>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            中華民國環境部（含前身行政院環境保護署）25 年來累積發布超過 {manifest.total_news.toLocaleString()} 篇新聞稿與法規公告。
            「<strong class="text-emerald-deep">環策晧脈</strong>」致力於從龐雜公告海中為台灣環境政策
            <strong class="text-amber-accent">找脈絡、把脈、把關</strong>——將零散單篇公告轉化為可檢索、可驗證、可追蹤「前世今生」的公共研究基礎設施。
          </p>
        </div>
      </div>
    </section>

    <!-- 資料來源與開放授權宣告 -->
    <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="font-serif text-xl font-bold text-emerald-deep">一、資料來源與開放授權宣告</h2>
      <div class="mt-3 space-y-3 text-sm leading-relaxed text-gray-700">
        <p>
          本站收錄之環境政策新聞基礎資料，主要來源為中華民國環境部「環境部新聞專區」及
          <a
            href="https://data.moenv.gov.tw/dataset/detail/MNEWS_P_01"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-emerald-deep underline underline-offset-2"
          >
            環境部環境資料開放平臺（資料集：MNEWS_P_01 環保新聞）↗
          </a>。
        </p>
        <p>
          上述政府公開資料均依據
          <a
            href="https://data.gov.tw/license"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-emerald-deep underline underline-offset-2"
          >
            中華民國政府資料開放授權條款－第 1 版（OGDL 1.0）↗
          </a>
          合法取用、彙整與索引，並於每篇新聞條目明確標示發布日期、發布司署與單篇官方原文連結。
        </p>
      </div>
    </section>

    <!-- 智慧財產權歸屬說明 -->
    <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="font-serif text-xl font-bold text-emerald-deep">二、智慧財產權歸屬說明</h2>
      <div class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-2 text-sm">
        <div class="rounded-xl border border-gray-100 bg-ivory p-4">
          <div class="font-bold text-emerald-deep">官方新聞稿與附檔</div>
          <p class="mt-1.5 leading-relaxed text-gray-600">
            原始新聞標題、新聞摘要、官方附件與法規公告內容之著作權與解釋權，均歸屬中華民國環境部及各原發布司署／機關所有。
          </p>
        </div>
        <div class="rounded-xl border border-amber-accent/20 bg-amber-soft/30 p-4">
          <div class="font-bold text-amber-accent">原創評論與研究加值</div>
          <p class="mt-1.5 leading-relaxed text-gray-700">
            本站原創之《晧哥說》政策評論、20 大政策議題分類詞表、政策演進時間軸編排、路線 3 雙層混合語意關聯網絡分析與視覺化圖表，均歸屬<strong>環策晧脈</strong>所有；歡迎學術研究與媒體依標準引用格式註明出處後合理引用。
          </p>
        </div>
      </div>
    </section>

    <!-- 獨立立場與免責聲明 -->
    <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="font-serif text-xl font-bold text-emerald-deep">三、獨立立場與免責聲明</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-gray-700">
        <li>
          <strong>非官方立場聲明</strong>：環策晧脈為獨立之環境政策觀察與研究平台，與中華民國環境部及任何政府機關均無隸屬、委託或代理關係。
        </li>
        <li>
          <strong>法規準據聲明</strong>：本站呈現之新聞摘要、議題分類、趨勢統計與《晧哥說》觀點僅供政策研究與實務參考；所有法規條文、碳費／空污費／水污費費率、施行日期與裁罰標準，均以<strong>環境部及行政院公報正式公告</strong>為最終準據。
        </li>
        <li>
          <strong>隱私與零追蹤承諾</strong>：本站前台不置放侵入式廣告與第三方追蹤 Cookie，致力維持乾淨、快速、專業的智庫閱讀體驗。
        </li>
      </ul>
    </section>

    <CitationBox title="環策晧脈：台灣環境政策長期觀測與研究平台" year="2026" />
  </div>
</BaseLayout>
