---
import '../styles/global.css';
import NewsDetailDrawer from '../components/NewsDetailDrawer.astro';
import { loadManifest, findPublicImage, formatTaipeiTimestamp } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '環策晧脈（HAO POLICY INTELLIGENCE）— 從環境部 25 年、一萬多篇官方新聞中，為台灣環境政策找脈絡、把脈、把關。',
} = Astro.props;
const currentPath = Astro.url.pathname;
const manifest = loadManifest();
const logoSrc = findPublicImage('logo');

const startYear = manifest.date_start ? Number(manifest.date_start.slice(0, 4)) : 2001;
const endYear = manifest.date_end ? Number(manifest.date_end.slice(0, 4)) : 2026;
const spanYears = Math.max(1, endYear - startYear + 1);
const syncTimeLabel = formatTaipeiTimestamp(manifest.updated_at);
const compactSyncFull = syncTimeLabel.replace(/:\d{2}\s*\(UTC\+8\)$/, '');
const compactSyncParts = compactSyncFull.match(/^(\d{4})-(\d{2}-\d{2}\s+\d{2}:\d{2})$/);
const syncYear = compactSyncParts ? compactSyncParts[1] : '';
const syncShort = compactSyncParts ? compactSyncParts[2] : compactSyncFull;

const navItems = [
  { href: '/', label: '首頁' },
  { href: '/hao-talks', label: '晧哥說' },
  { href: '/policy-map', label: '政策神經網' },
  { href: '/trends', label: '趨勢脈絡' },
  { href: '/news', label: '全量新聞' },
  { href: '/research', label: '研究觀察' },
  { href: '/architecture', label: '建站幕後' },
  { href: '/about', label: '關於與宣告' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href === '/trends' && currentPath.startsWith('/topics')) return true;
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | 環策晧脈 HAO Policy Intelligence</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&family=Noto+Serif+TC:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://hao-element-matrix.pages.dev/badge.js" defer></script>
  </head>
  <body class="bg-ivory text-gray-800 antialiased">
    <!-- 通透象牙白毛玻璃雙層旗艦 Banner -->
    <header class="sticky top-0 z-40 border-b border-emerald-950/10 bg-[#F8F9F7]/95 backdrop-blur-md">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-6 xl:px-10">
        <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_228px] xl:grid-cols-[minmax(0,1fr)_258px] lg:gap-4 xl:gap-5 lg:items-stretch">
          <!-- 左側雙層區 -->
          <div class="min-w-0 flex flex-col">
            <!-- 第 1 層：O 元素方塊、分隔線、環策晧脈主 Logo、主要導覽連結 -->
            <div class="flex items-center justify-between gap-2 py-2 lg:py-2.5">
              <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
                <a
                  href="https://hao-element-matrix.pages.dev/"
                  target="_blank"
                  rel="noopener noreferrer"
                  title="晧脈元素庫 · 元素 #08 O（氧）"
                  aria-label="前往主站：晧脈元素庫 · 元素 #08 O（氧）"
                  class="group relative flex h-[40px] w-[40px] sm:h-[44px] sm:w-[44px] shrink-0 flex-col items-center justify-between rounded-xl border border-emerald-300/35 bg-gradient-to-br from-[#0F4C3A] to-[#082E23] px-1.5 py-1 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300/75 hover:shadow-md"
                >
                  <span class="self-start font-mono text-[8px] sm:text-[8.5px] font-semibold leading-none text-emerald-300/95">08</span>
                  <span class="-mt-0.5 font-sans text-[17px] sm:text-[19px] font-bold leading-none tracking-tight text-white">O</span>
                  <span class="font-mono text-[7px] sm:text-[7.5px] font-medium leading-none tracking-wide text-emerald-200/90">Oxygen</span>
                </a>
                <span aria-hidden="true" class="h-7 w-px bg-emerald-950/15 shrink-0"></span>
                <a href="/" class="flex items-center gap-3 group shrink-0">
                  {logoSrc ? (
                    <img
                      src={logoSrc}
                      alt="環策晧脈 HAO POLICY INTELLIGENCE"
                      class="h-[52px] sm:h-[58px] lg:h-[64px] w-auto object-contain transition-opacity group-hover:opacity-90"
                    />
                  ) : (
                    <>
                      <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-deep font-serif text-xl font-bold text-white shadow-sm">
                        脈
                      </div>
                      <div>
                        <div class="font-serif text-xl font-bold tracking-wide text-emerald-deep leading-tight">環策晧脈</div>
                        <div class="text-[10px] tracking-[0.14em] text-emerald-deep/70 uppercase">
                          HAO Policy Intelligence
                        </div>
                      </div>
                    </>
                  )}
                </a>
              </div>

              <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1" aria-label="主導覽列">
                {navItems.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      'whitespace-nowrap rounded-full px-1.5 xl:px-2.5 py-1.5 text-[12.5px] xl:text-[13.5px] transition',
                      isActive(item.href)
                        ? 'bg-emerald-900/10 text-emerald-950 font-semibold'
                        : 'text-[#0F4C3A] font-medium hover:bg-emerald-900/5 hover:text-emerald-950',
                    ]}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>

              <button
                id="mobile-menu-btn"
                type="button"
                class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-emerald-deep hover:bg-emerald-900/5"
                aria-label="開啟選單"
                aria-expanded="false"
              >
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </button>
            </div>

            <!-- 第 2 層：4 項即時統計精簡淺色 KPI 卡片列 + 右側淺色元素徽章 -->
            <div class="border-t border-emerald-950/[0.07] py-1.5 lg:py-2">
              <div class="flex flex-wrap lg:flex-nowrap items-center justify-between gap-1.5 xl:gap-2">
                <div class="grid w-full grid-cols-2 gap-1.5 sm:flex sm:w-auto sm:flex-wrap lg:flex-nowrap sm:items-center sm:gap-1.5 xl:gap-2">
                  <div class="min-w-0 flex items-center justify-between gap-1.5 xl:gap-2 rounded-lg border border-[#0F4C3A]/10 bg-white/85 px-2 xl:px-2.5 py-1 shadow-[0_1px_2px_rgba(15,76,58,0.03)]">
                    <span class="text-[10px] font-medium text-gray-500 whitespace-nowrap">累計新聞</span>
                    <span class="font-mono text-[11px] xl:text-xs font-bold text-[#0F4C3A] whitespace-nowrap">
                      {manifest.total_news.toLocaleString()} <span class="font-sans text-[10px] font-normal text-gray-500">篇</span>
                    </span>
                  </div>
                  <div class="min-w-0 flex items-center justify-between gap-1.5 xl:gap-2 rounded-lg border border-[#0F4C3A]/10 bg-white/85 px-2 xl:px-2.5 py-1 shadow-[0_1px_2px_rgba(15,76,58,0.03)]">
                    <span class="text-[10px] font-medium text-gray-500 whitespace-nowrap">政策觀測</span>
                    <span class="font-mono text-[11px] xl:text-xs font-bold text-[#0F4C3A] whitespace-nowrap">
                      {spanYears} <span class="font-sans text-[10px] font-normal text-gray-500">年</span>
                    </span>
                  </div>
                  <div class="min-w-0 flex items-center justify-between gap-1.5 xl:gap-2 rounded-lg border border-[#0F4C3A]/10 bg-white/85 px-2 xl:px-2.5 py-1 shadow-[0_1px_2px_rgba(15,76,58,0.03)]">
                    <span class="text-[10px] font-medium text-gray-500 whitespace-nowrap">政策脈絡</span>
                    <span class="font-mono text-[11px] xl:text-xs font-bold text-[#B45309] whitespace-nowrap">
                      {(manifest.total_relation_edges ?? 0).toLocaleString()} <span class="font-sans text-[10px] font-normal text-gray-500">條</span>
                    </span>
                  </div>
                  <div
                    title={`最近更新：${syncTimeLabel}`}
                    class="min-w-0 flex items-center justify-between gap-1.5 xl:gap-2 rounded-lg border border-[#0F4C3A]/10 bg-white/85 px-2 xl:px-2.5 py-1 shadow-[0_1px_2px_rgba(15,76,58,0.03)]"
                  >
                    <span class="text-[10px] font-medium text-gray-500 whitespace-nowrap">資料同步</span>
                    <span class="truncate font-mono text-[11px] font-semibold text-gray-700 whitespace-nowrap">
                      {syncYear && <span class="hidden sm:inline">{syncYear}-</span>}{syncShort}
                    </span>
                  </div>
                </div>

                <div class="hidden lg:flex shrink-0 items-center">
                  <hao-element-badge symbol="O" theme="light"></hao-element-badge>
                </div>
              </div>
            </div>
          </div>

          <!-- 右側橫跨兩層：環策晧脈中樞流光圖譜縮小版（手機版自動隱藏） -->
          <div class="hidden lg:flex py-2">
            <a
              href="/architecture"
              title="查看完整環策晧脈中樞流光圖譜"
              class="group flex w-full flex-col justify-between overflow-hidden rounded-2xl border border-emerald-500/30 bg-gradient-to-b from-[#071A14] to-[#04110D] px-3 py-2 text-emerald-50 shadow-[0_4px_16px_rgba(7,26,20,0.22)] transition hover:-translate-y-0.5 hover:border-emerald-400/55 hover:shadow-[0_6px_22px_rgba(15,76,58,0.28)]"
              style="background-image: linear-gradient(to bottom, #071A14, #04110D), linear-gradient(rgba(16, 185, 129, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(16, 185, 129, 0.08) 1px, transparent 1px); background-size: 100% 100%, 16px 16px, 16px 16px; background-blend-mode: normal, screen, screen;"
            >
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5">
                  <span class="relative flex h-2 w-2 shrink-0">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_6px_#34D399]"></span>
                  </span>
                  <span class="font-mono text-[9px] font-bold tracking-[0.12em] text-emerald-300 uppercase">
                    MOENV · PULSE ATLAS
                  </span>
                </div>
                <span class="rounded-full border border-emerald-400/30 bg-emerald-950/70 px-1.5 py-0.5 font-mono text-[8px] font-bold tracking-wider text-emerald-300">
                  LIVE
                </span>
              </div>

              <!-- 縮小版五站式弧線流光圖譜 SVG -->
              <div class="my-0.5 flex items-center justify-center">
                <svg class="h-[64px] w-full select-none overflow-visible" viewBox="0 0 240 76" fill="none" aria-hidden="true">
                  <defs>
                    <filter id="banner-glow-green" x="-40%" y="-40%" width="180%" height="180%">
                      <feGaussianBlur stdDeviation="1.8" result="blur" />
                      <feMerge>
                        <feMergeNode in="blur" />
                        <feMergeNode in="SourceGraphic" />
                      </feMerge>
                    </filter>
                    <filter id="banner-glow-amber" x="-50%" y="-50%" width="200%" height="200%">
                      <feGaussianBlur stdDeviation="2.2" result="blur" />
                      <feMerge>
                        <feMergeNode in="blur" />
                        <feMergeNode in="SourceGraphic" />
                      </feMerge>
                    </filter>
                    <linearGradient id="banner-beam-emerald" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#10B981" stop-opacity="0.35" />
                      <stop offset="50%" stop-color="#34D399" stop-opacity="0.95" />
                      <stop offset="100%" stop-color="#10B981" stop-opacity="0.35" />
                    </linearGradient>
                    <linearGradient id="banner-beam-amber" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#10B981" stop-opacity="0.4" />
                      <stop offset="50%" stop-color="#F59E0B" stop-opacity="0.95" />
                      <stop offset="100%" stop-color="#34D399" stop-opacity="0.4" />
                    </linearGradient>
                  </defs>

                  <!-- 水平基準軸 -->
                  <line x1="16" y1="50" x2="224" y2="50" stroke="url(#banner-beam-emerald)" stroke-width="0.9" opacity="0.5" />

                  <!-- 主弧線與跨站回饋弧線 -->
                  <g fill="none">
                    <path id="banner-arc-1-2" d="M 24 50 Q 48 22 72 50" stroke="url(#banner-beam-emerald)" stroke-width="1.3" opacity="0.85" />
                    <path id="banner-arc-2-3" d="M 72 50 Q 96 22 120 50" stroke="url(#banner-beam-emerald)" stroke-width="1.3" opacity="0.85" />
                    <path id="banner-arc-3-4" d="M 120 50 Q 144 22 168 50" stroke="url(#banner-beam-amber)" stroke-width="1.3" opacity="0.85" />
                    <path id="banner-arc-4-5" d="M 168 50 Q 192 22 216 50" stroke="url(#banner-beam-emerald)" stroke-width="1.3" opacity="0.85" />
                    <path id="banner-arc-2-5" d="M 72 50 Q 144 2 216 50" stroke="url(#banner-beam-emerald)" stroke-width="0.9" stroke-dasharray="2.5 2.5" opacity="0.55" />
                    <path id="banner-arc-1-3" d="M 24 50 Q 72 10 120 50" stroke="url(#banner-beam-amber)" stroke-width="0.9" stroke-dasharray="2 2.5" opacity="0.5" />
                    <path id="banner-arc-4-2" d="M 168 50 Q 120 71 72 50" stroke="#F59E0B" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.45" />
                  </g>

                  <!-- 穿梭流光粒子 -->
                  <g filter="url(#banner-glow-green)">
                    <circle r="1.9" fill="#FFFFFF" opacity="0">
                      <animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#banner-arc-1-2" /></animateMotion>
                      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="2.6s" repeatCount="indefinite" />
                    </circle>
                    <circle r="1.9" fill="#34D399" opacity="0">
                      <animateMotion dur="2.6s" begin="0.7s" repeatCount="indefinite"><mpath href="#banner-arc-2-3" /></animateMotion>
                      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="2.6s" begin="0.7s" repeatCount="indefinite" />
                    </circle>
                    <circle r="1.9" fill="#FBBF24" opacity="0">
                      <animateMotion dur="2.6s" begin="1.4s" repeatCount="indefinite"><mpath href="#banner-arc-3-4" /></animateMotion>
                      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="2.6s" begin="1.4s" repeatCount="indefinite" />
                    </circle>
                    <circle r="1.9" fill="#FFFFFF" opacity="0">
                      <animateMotion dur="2.6s" begin="2.0s" repeatCount="indefinite"><mpath href="#banner-arc-4-5" /></animateMotion>
                      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="2.6s" begin="2.0s" repeatCount="indefinite" />
                    </circle>
                    <circle r="1.7" fill="#34D399" opacity="0">
                      <animateMotion dur="4.2s" begin="0.3s" repeatCount="indefinite"><mpath href="#banner-arc-2-5" /></animateMotion>
                      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="4.2s" begin="0.3s" repeatCount="indefinite" />
                    </circle>
                    <circle r="1.6" fill="#FBBF24" opacity="0">
                      <animateMotion dur="3.6s" begin="1.1s" repeatCount="indefinite"><mpath href="#banner-arc-1-3" /></animateMotion>
                      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="3.6s" begin="1.1s" repeatCount="indefinite" />
                    </circle>
                    <circle r="1.5" fill="#F59E0B" opacity="0">
                      <animateMotion dur="3.8s" begin="0.9s" repeatCount="indefinite"><mpath href="#banner-arc-4-2" /></animateMotion>
                      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.08;0.92;1" dur="3.8s" begin="0.9s" repeatCount="indefinite" />
                    </circle>
                  </g>

                  <!-- 5 站發光節點 (01 ~ 05) -->
                  <g>
                    <circle cx="24" cy="50" r="6" fill="#071A14" stroke="#34D399" stroke-width="1.3" filter="url(#banner-glow-green)" />
                    <text x="24" y="52.2" text-anchor="middle" fill="#ECFDF5" font-family="monospace" font-size="5.5" font-weight="700">01</text>

                    <circle cx="72" cy="50" r="6" fill="#071A14" stroke="#34D399" stroke-width="1.3" filter="url(#banner-glow-green)" />
                    <text x="72" y="52.2" text-anchor="middle" fill="#ECFDF5" font-family="monospace" font-size="5.5" font-weight="700">02</text>

                    <circle cx="120" cy="50" r="6" fill="#071A14" stroke="#34D399" stroke-width="1.3" filter="url(#banner-glow-green)" />
                    <text x="120" y="52.2" text-anchor="middle" fill="#ECFDF5" font-family="monospace" font-size="5.5" font-weight="700">03</text>

                    <!-- 04 晧哥把脈台（暖金外環高亮） -->
                    <circle cx="168" cy="50" r="8.2" fill="none" stroke="#F59E0B" stroke-width="0.9" stroke-opacity="0.55" />
                    <circle cx="168" cy="50" r="6" fill="#071A14" stroke="#FBBF24" stroke-width="1.5" filter="url(#banner-glow-amber)" />
                    <text x="168" y="52.2" text-anchor="middle" fill="#FEF3C7" font-family="monospace" font-size="5.5" font-weight="700">04</text>

                    <circle cx="216" cy="50" r="6" fill="#071A14" stroke="#34D399" stroke-width="1.3" filter="url(#banner-glow-green)" />
                    <text x="216" y="52.2" text-anchor="middle" fill="#ECFDF5" font-family="monospace" font-size="5.5" font-weight="700">05</text>
                  </g>
                </svg>
              </div>

              <div class="flex items-center justify-between text-[9.5px] text-emerald-200/80">
                <span>中樞流光圖譜 · 五站即時串流</span>
                <span class="font-semibold text-amber-300 transition-transform group-hover:translate-x-0.5">→</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <div id="mobile-menu" class="hidden lg:hidden border-t border-emerald-950/10 bg-[#FAFBF9] px-4 py-3 shadow-sm">
        <div class="flex flex-col gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-xl px-3.5 py-2.5 text-sm transition',
                isActive(item.href)
                  ? 'bg-emerald-900/10 text-emerald-950 font-semibold'
                  : 'text-[#0F4C3A] font-medium hover:bg-emerald-900/5',
              ]}
            >
              {item.label}
            </a>
          ))}
          <div class="mt-2 border-t border-emerald-950/10 pt-2.5 flex items-center">
            <hao-element-badge symbol="O" theme="light"></hao-element-badge>
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-10">
      <slot />
    </main>

    <footer class="mt-20 border-t border-emerald-950/10 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-10">
        <div class="flex flex-col gap-3 text-xs leading-relaxed text-gray-600 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-4xl space-y-1.5">
            <div>
              所屬矩陣：
              <a
                href="https://hao-element-matrix.pages.dev/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-emerald-deep underline underline-offset-2 hover:text-emerald-dark"
              >
                晧脈元素庫 · 元素 O（氧）↗
              </a>
            </div>
            <div>
              資料來源：中華民國環境部（環境部新聞專區及環境資料開放平臺
              <code class="rounded bg-ivory px-1.5 py-0.5 text-[11px] text-emerald-deep">MNEWS_P_01</code>），依政府資料開放授權條款引用｜本站為獨立政策觀察與研究平台，非環境部官方網站｜《晧哥說》與脈絡分析 © 環策晧脈。
              <a href="/about" class="ml-1.5 font-semibold text-emerald-deep underline underline-offset-2 hover:text-emerald-dark">
                完整資料宣告與免責聲明 →
              </a>
            </div>
          </div>
          <div class="shrink-0 text-[11px] text-gray-500">
            累計收錄 <strong class="text-gray-700">{manifest.total_news.toLocaleString()}</strong> 篇 · 最近更新：{formatTaipeiTimestamp(manifest.updated_at)}
          </div>
        </div>
      </div>
    </footer>

    <NewsDetailDrawer />

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
      }

      const revealEls = document.querySelectorAll('.reveal-section');
      if ('IntersectionObserver' in window && revealEls.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
