---
import { loadTrends } from '../lib/data';

interface Props {
  idPrefix?: string;
}

const { idPrefix = 'race' } = Astro.props;
const trends = loadTrends();
const years = trends.topic_yearly_matrix.years;
const topics = trends.topic_yearly_matrix.topics;
const latestYear = years[years.length - 1] ?? '2026';
---

<section
  id="policy-theater"
  class="policy-race-widget rounded-3xl border border-emerald-950/[0.07] bg-white p-6 shadow-[0_8px_30px_rgb(15,76,58,0.05)] sm:p-8 lg:p-10"
  data-prefix={idPrefix}
>
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-amber-accent">
        25-Year Policy Pulse Theater
      </span>
      <h2 class="mt-1 font-serif text-2xl font-bold text-emerald-deep sm:text-3xl">
        25 年政策脈動動態劇場（2001–{latestYear}）
      </h2>
      <p class="mt-1.5 max-w-2xl text-xs leading-relaxed text-gray-600 sm:text-sm">
        按下播放，親眼看見 25 年來環境治理重心如何從早期的「空氣品質、水質保護、環境執法」，一步步交棒給「淨零轉型、資源循環、氣候變遷與調適」。
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <button
        type="button"
        class="race-play-btn inline-flex items-center gap-1.5 rounded-full bg-emerald-deep px-4 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-dark"
      >
        ▶ 播放 25 年演變
      </button>
      <button
        type="button"
        class="race-replay-btn inline-flex items-center rounded-full border border-emerald-deep/20 bg-ivory px-3.5 py-2 text-xs font-semibold text-emerald-deep transition hover:bg-emerald-soft"
      >
        重播
      </button>
    </div>
  </div>

  <!-- 年份拖曳控制條 -->
  <div class="mt-5 flex flex-wrap items-center gap-4 rounded-2xl bg-ivory/90 px-4 py-3">
    <span class="font-mono text-xs font-semibold text-gray-500">{years[0]}</span>
    <input
      type="range"
      min="0"
      max={Math.max(0, years.length - 1)}
      value={Math.max(0, years.length - 1)}
      class="race-slider h-2 flex-1 cursor-pointer accent-emerald-deep"
      aria-label="切換年份"
    />
    <span class="font-mono text-xs font-semibold text-gray-500">{latestYear}</span>
    <span class="race-year-pill rounded-full bg-emerald-deep px-3 py-1 font-mono text-xs font-bold text-white">
      {latestYear}
    </span>
  </div>

  <!-- 圖表舞台 + 年份大浮水印 -->
  <div class="relative mt-4">
    <div
      class="race-watermark pointer-events-none absolute bottom-10 right-6 z-0 select-none font-serif text-6xl font-bold text-emerald-deep/[0.08] sm:text-8xl"
    >
      {latestYear}
    </div>
    <div class="race-chart relative z-10 h-[390px] w-full"></div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-3 text-[11px] text-gray-500">
    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#0F4C3A]"></span>氣候與碳定價</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#0D9488]"></span>資源循環與廢棄物</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#2563EB]"></span>污染防制</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#B45309]"></span>治理與制度</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#7C3AED]"></span>社會溝通與人才</span>
  </div>

  <script
    type="application/json"
    class="race-payload"
    set:html={JSON.stringify({ years, topics })}
  />
</section>

<script>
  import * as echarts from 'echarts';

  const groupColors: Record<string, string> = {
    '氣候與碳定價': '#0F4C3A',
    '資源循環與廢棄物': '#0D9488',
    '污染防制': '#2563EB',
    '治理與制度': '#B45309',
    '社會溝通與人才': '#7C3AED',
  };

  document.querySelectorAll<HTMLElement>('.policy-race-widget').forEach((root) => {
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const payloadEl = root.querySelector<HTMLScriptElement>('.race-payload');
    const chartEl = root.querySelector<HTMLElement>('.race-chart');
    const playBtn = root.querySelector<HTMLButtonElement>('.race-play-btn');
    const replayBtn = root.querySelector<HTMLButtonElement>('.race-replay-btn');
    const slider = root.querySelector<HTMLInputElement>('.race-slider');
    const yearPill = root.querySelector<HTMLElement>('.race-year-pill');
    const watermark = root.querySelector<HTMLElement>('.race-watermark');

    if (!payloadEl || !chartEl) return;
    const { years, topics } = JSON.parse(payloadEl.textContent || '{}');
    if (!Array.isArray(years) || !years.length) return;

    const chart = echarts.init(chartEl);
    let currentIndex = years.length - 1;
    let timer: number | null = null;

    function renderYear(idx: number) {
      currentIndex = Math.max(0, Math.min(years.length - 1, idx));
      const yr = years[currentIndex];
      if (slider) slider.value = String(currentIndex);
      if (yearPill) yearPill.textContent = yr;
      if (watermark) watermark.textContent = yr;

      const ranked = (topics || [])
        .map((t: any) => ({
          title: t.title,
          group: t.group,
          slug: t.slug,
          value: (t.counts || [])[currentIndex] || 0,
        }))
        .sort((a: any, b: any) => b.value - a.value)
        .slice(0, 10);

      chart.setOption({
        animationDuration: 550,
        animationDurationUpdate: 550,
        animationEasing: 'cubicOut',
        animationEasingUpdate: 'cubicOut',
        grid: { left: 132, right: 48, top: 14, bottom: 24 },
        tooltip: {
          trigger: 'axis',
          axisPointer: { type: 'shadow' },
          formatter: (params: any) => {
            const p = params[0];
            return `<strong>${yr} 年｜${p.name}</strong><br/>年度新聞量：<strong>${p.value}</strong> 篇`;
          },
        },
        xAxis: {
          type: 'value',
          max: 'dataMax',
          splitLine: { lineStyle: { color: '#F3F4F6' } },
          axisLabel: { color: '#6B7280', fontSize: 11 },
        },
        yAxis: {
          type: 'category',
          inverse: true,
          data: ranked.map((r: any) => r.title),
          axisLine: { show: false },
          axisTick: { show: false },
          axisLabel: { color: '#1F2937', fontSize: 12, fontWeight: 500 },
        },
        series: [
          {
            type: 'bar',
            barWidth: 20,
            data: ranked.map((r: any) => ({
              value: r.value,
              slug: r.slug,
              itemStyle: {
                color: groupColors[r.group] || '#0F4C3A',
                borderRadius: [0, 8, 8, 0],
              },
            })),
            label: {
              show: true,
              position: 'right',
              valueAnimation: true,
              fontSize: 11,
              fontWeight: 600,
              color: '#374151',
              formatter: '{c} 篇',
            },
          },
        ],
      });
    }

    function stopPlay() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
      if (playBtn) playBtn.textContent = '▶ 播放 25 年演變';
    }

    function startPlay(fromBeginning = false) {
      stopPlay();
      if (fromBeginning || currentIndex >= years.length - 1) {
        currentIndex = 0;
        renderYear(0);
      }
      if (playBtn) playBtn.textContent = '⏸ 暫停播放';
      timer = window.setInterval(() => {
        if (currentIndex + 1 >= years.length) {
          stopPlay();
          return;
        }
        renderYear(currentIndex + 1);
      }, 650);
    }

    playBtn?.addEventListener('click', () => {
      if (timer !== null) stopPlay();
      else startPlay(false);
    });

    replayBtn?.addEventListener('click', () => startPlay(true));

    slider?.addEventListener('input', () => {
      stopPlay();
      renderYear(Number(slider.value || '0'));
    });

    chart.on('click', (p: any) => {
      if (p.data?.slug) {
        window.location.href = `/topics/${p.data.slug}`;
      }
    });

    renderYear(currentIndex);
    window.addEventListener('resize', () => chart.resize());
  });
</script>
