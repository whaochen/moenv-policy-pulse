      arcEdges.forEach(([src, dst]) => {
        const s = leftPos.get(src);
        const d = rightPos.get(dst);
        if (!s || !d) return;
        const p = document.createElementNS(svgNS, 'path');
        p.setAttribute('d', `M ${s.x} ${s.y} C 430 ${s.y}, 490 ${d.y}, ${d.x} ${d.y}`);
        p.setAttribute('stroke', dst === 'R1' || dst === 'R2' ? '#F59E0B' : '#34D399');
        p.setAttribute('stroke-width', '1.4');
        p.setAttribute('opacity', '0.45');
        p.setAttribute('class', 'arc-edge transition-opacity');
        p.dataset.src = src;
        p.dataset.dst = dst;
        linksLayer.appendChild(p);
      });

      function highlightArcNode(nodeId: string | null) {
        const connected = new Set<string>();
        if (nodeId) connected.add(nodeId);

        root.querySelectorAll<SVGPathElement>('.arc-edge').forEach((edge) => {
          const s = edge.dataset.src || '';
          const d = edge.dataset.dst || '';
          if (!nodeId) {
            edge.setAttribute('opacity', '0.45');
            edge.setAttribute('stroke-width', '1.4');
            edge.removeAttribute('filter');
          } else if (s === nodeId || d === nodeId) {
            connected.add(s);
            connected.add(d);
            edge.setAttribute('opacity', '0.98');
            edge.setAttribute('stroke-width', '2.8');
            edge.setAttribute('filter', 'url(#arc-glow)');
          } else {
            edge.setAttribute('opacity', '0.12');
            edge.setAttribute('stroke-width', '1');
            edge.removeAttribute('filter');
          }
