      }

      root.querySelectorAll<SVGGElement>('.arc-node').forEach((node) => {
        const nid = node.dataset.nodeId || '';
        node.addEventListener('mouseenter', () => highlightArcNode(nid));
        node.addEventListener('click', () => highlightArcNode(nid));
