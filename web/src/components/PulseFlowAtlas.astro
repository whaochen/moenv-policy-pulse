---
import { loadManifest, loadTrends, getPublishedHaoTalks, formatTaipeiTimestamp } from '../lib/data';

const manifest = loadManifest();
const trends = loadTrends();
const publishedTalks = await getPublishedHaoTalks();

const startYear = manifest.date_start ? Number(manifest.date_start.slice(0, 4)) : 2001;
const endYear = manifest.date_end ? Number(manifest.date_end.slice(0, 4)) : 2026;
const spanYears = Math.max(1, endYear - startYear + 1);
const initialNews = manifest.total_news;
const initialRelations = manifest.total_relation_edges ?? 0;
const initialSync = formatTaipeiTimestamp(manifest.updated_at);
const initialTalksCount = publishedTalks.length;
const initial30dCount = manifest.last_30_days_count ?? 0;

function sumEra(minY: number, maxY: number): number {
  return (trends.yearly_totals || []).reduce((acc, row) => {
    const y = Number(row.year);
    return y >= minY && y <= maxY ? acc + (row.count || 0) : acc;
  }, 0);
}

const era1 = sumEra(2001, 2010);
const era2 = sumEra(2011, 2015);
const era3 = sumEra(2016, 2020);
const era4 = sumEra(2021, 2026);
---

<div
  id="hao-pulse-flow-atlas"
  class="relative overflow-hidden rounded-2xl border border-emerald-500/25 bg-gradient-to-b from-[#071A14] to-[#04110D] text-emerald-50 shadow-2xl"
  style="background-image: linear-gradient(to bottom, #071A14, #04110D), linear-gradient(rgba(16, 185, 129, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(16, 185, 129, 0.08) 1px, transparent 1px); background-size: 100% 100%, 36px 36px, 36px 36px; background-blend-mode: normal, screen, screen;"
>
  <!-- 1. 頂部遙測控制列（Telemetry Header） -->
  <div class="flex flex-col gap-3 border-b border-emerald-500/20 bg-black/25 px-4 py-3.5 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
    <!-- 左側標題 -->
    <div class="flex items-center gap-3">
      <span class="relative flex h-3 w-3 shrink-0">
        <span class="atlas-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-3 w-3 rounded-full bg-emerald-400 shadow-[0_0_10px_#34D399]"></span>
      </span>
      <div>
        <div class="font-mono text-xs font-bold tracking-[0.16em] text-emerald-300 sm:text-sm">
          HAO PULSE FLOW ATLAS
        </div>
        <div class="text-[11px] text-emerald-100/70">
          環策晧脈全自動資料流動與 AI 協作中樞
        </div>
      </div>
    </div>

    <!-- 中間三視圖切換膠囊 -->
    <div class="inline-flex self-start rounded-full border border-emerald-500/25 bg-[#04110D]/90 p-1 font-mono text-xs lg:self-auto" role="tablist" aria-label="圖譜視圖切換">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-atlas-view="flows"
        class="atlas-view-btn rounded-full bg-emerald-500/25 px-3.5 py-1.5 font-bold text-emerald-200 shadow-[0_0_12px_rgba(16,185,129,0.25)] transition"
      >
        FLOWS
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-atlas-view="arcs"
        class="atlas-view-btn rounded-full px-3.5 py-1.5 font-medium text-emerald-200/60 transition hover:text-emerald-200"
      >
        ARCS
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-atlas-view="logs"
        class="atlas-view-btn rounded-full px-3.5 py-1.5 font-medium text-emerald-200/60 transition hover:text-emerald-200"
      >
        LOGS
      </button>
    </div>

    <!-- 右側 LIVE 狀態與巡航控制 -->
    <div class="flex flex-wrap items-center gap-3 text-xs">
      <div class="flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-950/60 px-3 py-1 font-mono text-[11px]">
        <span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34D399]"></span>
        <span class="font-bold text-emerald-300">LIVE</span>
        <span class="text-emerald-200/75" id="atlas-header-sync">{initialSync}</span>
      </div>
      <button
        type="button"
        id="atlas-cruise-btn"
        class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-500/15 px-3 py-1 font-mono text-[11px] font-semibold text-amber-300 transition hover:bg-amber-500/25"
      >
        ⏸ 暫停巡航
      </button>
    </div>
  </div>

  <!-- 2. 視圖一：FLOWS（V2.5 三段式海量匯流煉金圖） -->
  <div id="atlas-panel-flows" class="atlas-panel p-4 sm:p-5">
    <!-- 上方精簡聚焦動態故事解說條（控制高度 ~120-135px，讓超過 65% 空間留給匯流畫布） -->
    <div class="mb-4 rounded-xl border border-emerald-400/25 bg-[#08241C]/85 px-4 py-3 backdrop-blur-md shadow-[0_8px_28px_rgba(0,0,0,0.35)]">
      <div class="flex flex-col gap-2.5 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span id="flow-card-step" class="rounded-full border border-amber-400/40 bg-amber-500/20 px-2.5 py-0.5 font-mono text-[11px] font-bold text-amber-300">
              STAGE 01 · 海量匯入
            </span>
            <span id="flow-card-scale" class="rounded-full border border-emerald-400/30 bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[11px] text-emerald-300">
              {initialNews.toLocaleString()} 篇官方新聞
            </span>
            <span id="flow-cruise-indicator" class="font-mono text-[11px] font-semibold text-emerald-200/75">
              01 / 04 · INGESTION
            </span>
          </div>
          <h3 id="flow-card-title" class="mt-1.5 font-serif text-base font-bold text-white sm:text-lg">
            百川匯海：無痛收錄 2001–2026 共 {initialNews.toLocaleString()} 篇官方新聞
          </h3>
          <p id="flow-card-desc" class="mt-0.5 text-xs leading-relaxed text-emerald-100/85">
            結合環境部歷史歸檔與 MNEWS_P_01 開放資料即時增量，每日 4 次自動入庫，完整保留 26 年環境治理全貌。
          </p>
        </div>

        <!-- 四階段快切膠囊 -->
        <div class="flex flex-wrap items-center gap-1.5 shrink-0">
          {[
            { idx: 0, label: '01 海量匯入' },
            { idx: 1, label: '02 系統工程' },
            { idx: 2, label: '03 AI 雙模型' },
            { idx: 3, label: '04 智庫產出' },
          ].map((s) => (
            <button
              type="button"
              data-stage-btn={s.idx}
              class:list={[
                'stage-pill-btn rounded-lg border px-2.5 py-1 font-mono text-[11px] font-semibold transition',
                s.idx === 0
                  ? 'border-amber-400/70 bg-amber-500/20 text-amber-200 shadow-[0_0_12px_rgba(245,158,11,0.22)]'
                  : 'border-emerald-500/25 bg-black/25 text-emerald-200/70 hover:border-emerald-400/50 hover:text-emerald-100',
              ]}
            >
              {s.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- 桌機版（>= 768px）：三段式海量匯流煉金畫布 -->
    <div id="stream-canvas-wrap" class="hidden md:block relative rounded-xl border border-emerald-500/15 bg-[#04120E]/70 px-4 py-5 overflow-hidden">
      <!-- 底層：動態計算座標的貝茲流道 SVG -->
      <svg
        id="stream-beams-svg"
        class="pointer-events-none absolute inset-0 h-full w-full"
        aria-hidden="true"
      >
        <defs>
          <filter id="stream-beam-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="2.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <linearGradient id="stream-grad-in" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#6EE7B7" stop-opacity="0.35" />
            <stop offset="60%" stop-color="#34D399" stop-opacity="0.75" />
            <stop offset="100%" stop-color="#10B981" stop-opacity="0.95" />
          </linearGradient>
          <linearGradient id="stream-grad-out" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.9" />
            <stop offset="55%" stop-color="#FBBF24" stop-opacity="0.75" />
            <stop offset="100%" stop-color="#34D399" stop-opacity="0.9" />
          </linearGradient>
        </defs>
        <g id="stream-beams-layer" fill="none"></g>
      </svg>

      <!-- 中層：高密度 60FPS HTML5 Canvas 粒子流 -->
      <canvas
        id="stream-particles-canvas"
        class="pointer-events-none absolute inset-0 h-full w-full"
        aria-hidden="true"
      ></canvas>

      <!-- 上層：三段式互動節點架構（左 5 源頭 / 中 2 核心+把脈台 / 右 4 成果） -->
      <div class="relative z-10 grid grid-cols-12 items-center gap-6 lg:gap-8">
        <!-- 左段（4 欄）：5 條並行時代匯流通道 -->
        <div class="col-span-4 space-y-2.5">
          <div class="mb-1 flex items-center justify-between px-1 font-mono text-[10px] font-bold tracking-widest text-emerald-300/80">
            <span>SOURCES · 2001–2026</span>
            <span id="stream-left-total">{initialNews.toLocaleString()} 篇</span>
          </div>

          <!-- 源頭 1: 2001-2010 -->
          <div
            data-stream-node="src-0"
            data-stage="0"
            data-anchor-side="right"
            class="stream-node cursor-pointer rounded-xl border border-emerald-400/25 bg-[#071D16]/90 px-3 py-2 backdrop-blur-sm transition duration-200 hover:border-emerald-300/70"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[11px] font-bold text-emerald-300">2001–2010</span>
              <span id="era-count-1" class="rounded bg-emerald-500/15 px-1.5 py-0.5 font-mono text-[11px] font-bold text-white">
                {era1.toLocaleString()} 篇
              </span>
            </div>
            <div class="mt-0.5 text-[11px] text-emerald-100/75 truncate">早期環保署歷史新聞</div>
          </div>

          <!-- 源頭 2: 2011-2015 -->
          <div
            data-stream-node="src-1"
            data-stage="0"
            data-anchor-side="right"
            class="stream-node cursor-pointer rounded-xl border border-emerald-400/25 bg-[#071D16]/90 px-3 py-2 backdrop-blur-sm transition duration-200 hover:border-emerald-300/70"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[11px] font-bold text-emerald-300">2011–2015</span>
              <span id="era-count-2" class="rounded bg-emerald-500/15 px-1.5 py-0.5 font-mono text-[11px] font-bold text-white">
                {era2.toLocaleString()} 篇
              </span>
            </div>
            <div class="mt-0.5 text-[11px] text-emerald-100/75 truncate">空水廢與環評治理新聞</div>
          </div>

          <!-- 源頭 3: 2016-2020 -->
          <div
            data-stream-node="src-2"
            data-stage="0"
            data-anchor-side="right"
            class="stream-node cursor-pointer rounded-xl border border-emerald-400/25 bg-[#071D16]/90 px-3 py-2 backdrop-blur-sm transition duration-200 hover:border-emerald-300/70"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[11px] font-bold text-emerald-300">2016–2020</span>
              <span id="era-count-3" class="rounded bg-emerald-500/15 px-1.5 py-0.5 font-mono text-[11px] font-bold text-white">
                {era3.toLocaleString()} 篇
              </span>
            </div>
            <div class="mt-0.5 text-[11px] text-emerald-100/75 truncate">永續轉型與空污防制新聞</div>
          </div>

          <!-- 源頭 4: 2021-2026 -->
          <div
            data-stream-node="src-3"
            data-stage="0"
            data-anchor-side="right"
            class="stream-node cursor-pointer rounded-xl border border-emerald-400/25 bg-[#071D16]/90 px-3 py-2 backdrop-blur-sm transition duration-200 hover:border-emerald-300/70"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[11px] font-bold text-emerald-300">2021–2026</span>
              <span id="era-count-4" class="rounded bg-emerald-500/15 px-1.5 py-0.5 font-mono text-[11px] font-bold text-white">
                {era4.toLocaleString()} 篇
              </span>
            </div>
            <div class="mt-0.5 text-[11px] text-emerald-100/75 truncate">升格環境部・淨零與碳費新局</div>
          </div>

          <!-- 源頭 5: LIVE MNEWS_P_01 -->
          <div
            data-stream-node="src-4"
            data-stage="0"
            data-anchor-side="right"
            class="stream-node cursor-pointer rounded-xl border border-emerald-300/45 bg-gradient-to-r from-[#0A2920]/95 to-[#071D16]/90 px-3 py-2 backdrop-blur-sm transition duration-200 hover:border-emerald-200"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold text-emerald-200">
                <span class="relative flex h-2 w-2">
                  <span class="atlas-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                </span>
                LIVE · MNEWS_P_01
              </span>
              <span id="era-count-live" class="rounded bg-emerald-400/20 px-1.5 py-0.5 font-mono text-[10px] font-bold text-emerald-200">
                近30天 {initial30dCount} 篇
              </span>
            </div>
            <div class="mt-0.5 text-[11px] text-emerald-100/80 truncate">環境部開放資料每日 4 次即時增量新訊</div>
          </div>
        </div>

        <!-- 中段（4 欄）：系統方法 × AI 雙核煉金中樞 ＋ 底部 Obsidian 晧哥把脈台 -->
        <div class="col-span-4 flex flex-col items-stretch justify-center gap-4">
          <!-- 核心 A：系統工程核 -->
          <div
            data-stream-node="core-a"
            data-stage="1"
            class="stream-node relative cursor-pointer rounded-2xl border border-emerald-400/45 bg-gradient-to-b from-[#0A2B21]/95 to-[#061A14]/95 p-3.5 shadow-[0_0_26px_rgba(16,185,129,0.16)] backdrop-blur-md transition duration-200 hover:border-emerald-300"
          >
            <div class="flex items-center gap-3">
              <!-- 翠綠旋轉刻度環圖示 -->
              <div class="relative flex h-11 w-11 shrink-0 items-center justify-center">
                <svg class="atlas-spin-slow h-11 w-11 text-emerald-400" viewBox="0 0 44 44" fill="none">
                  <circle cx="22" cy="22" r="19" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="3 3" />
                  <circle cx="22" cy="22" r="14" stroke="#34D399" stroke-width="1.8" stroke-dasharray="22 10" />
                </svg>
                <span class="absolute font-mono text-[10px] font-bold text-emerald-200">SYS</span>
              </div>
              <div class="min-w-0">
                <div class="font-mono text-[10px] font-bold tracking-wider text-emerald-300">SYSTEM ENGINE</div>
                <div class="font-serif text-sm font-bold text-white">系統化清洗與索引</div>
              </div>
            </div>
            <div class="mt-2.5 flex flex-wrap gap-1 text-[10px] font-medium text-emerald-100/85">
              <span class="rounded bg-black/30 px-1.5 py-0.5 border border-emerald-500/20">GitHub Actions 每日 4 次</span>
              <span class="rounded bg-black/30 px-1.5 py-0.5 border border-emerald-500/20">雙重指紋去重</span>
              <span class="rounded bg-black/30 px-1.5 py-0.5 border border-emerald-500/20">單篇原網址配對</span>
              <span class="rounded bg-black/30 px-1.5 py-0.5 border border-emerald-500/20">20 大議題詞典</span>
            </div>
          </div>

          <!-- 核心 B：AI 語意雙模型核 -->
          <div
            data-stream-node="core-b"
            data-stage="2"
            class="stream-node relative cursor-pointer rounded-2xl border border-amber-400/50 bg-gradient-to-b from-[#1A2416]/95 via-[#0B231B]/95 to-[#071813]/95 p-3.5 shadow-[0_0_30px_rgba(245,158,11,0.16)] backdrop-blur-md transition duration-200 hover:border-amber-300"
          >
            <div class="flex items-center gap-3">
              <!-- 暖金 × 翠綠雙色脈衝光環 -->
              <div class="relative flex h-11 w-11 shrink-0 items-center justify-center">
                <svg class="atlas-spin-reverse h-11 w-11" viewBox="0 0 44 44" fill="none">
                  <circle cx="22" cy="22" r="19" stroke="#F59E0B" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="6 4" />
                  <circle cx="22" cy="22" r="14" stroke="#34D399" stroke-width="1.8" stroke-dasharray="16 8" />
                </svg>
                <span class="absolute font-mono text-[10px] font-bold text-amber-300">AI</span>
              </div>
              <div class="min-w-0">
                <div class="font-mono text-[10px] font-bold tracking-wider text-amber-300">AI SEMANTIC CORE</div>
                <div class="font-serif text-sm font-bold text-white">Gemini 雙模型 × TF-IDF</div>
              </div>
            </div>
            <div class="mt-2.5 flex flex-wrap gap-1 text-[10px] font-medium text-amber-100/90">
              <span class="rounded bg-black/35 px-1.5 py-0.5 border border-amber-400/25">Gemini 2.5 Flash-Lite 摘要</span>
              <span class="rounded bg-black/35 px-1.5 py-0.5 border border-emerald-400/25">gemini-embedding-001 向量</span>
              <span id="core-b-edges" class="rounded bg-amber-500/15 px-1.5 py-0.5 border border-amber-400/35 text-amber-200 font-semibold">
                編織 {initialRelations.toLocaleString()} 關聯邊
              </span>
            </div>
          </div>

          <!-- 核心下方掛載：人機協作節點（Obsidian 晧哥把脈台） -->
          <div
            data-stream-node="core-human"
            data-stage="3"
            class="stream-node cursor-pointer rounded-xl border border-amber-400/50 bg-gradient-to-r from-[#241A09]/90 via-[#151D13]/90 to-[#0B221B]/90 px-3.5 py-2.5 shadow-[0_0_20px_rgba(245,158,11,0.12)] transition duration-200 hover:border-amber-300"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[10px] font-bold tracking-wider text-amber-300">
                OBSIDIAN VAULT · 晧哥把脈
              </span>
              <span class="rounded-full bg-amber-500/20 px-2 py-0.5 font-mono text-[9px] font-bold text-amber-200">
                HUMAN-IN-LOOP
              </span>
            </div>
            <div class="mt-0.5 text-[11px] font-medium text-amber-50/90">
              AI 處理萬篇脈絡，晧哥寫出《晧哥說》
            </div>
          </div>
        </div>

        <!-- 右段（4 欄）：4 大智庫成果分流卡 -->
        <div class="col-span-4 space-y-2.5">
          <div class="mb-1 flex items-center justify-between px-1 font-mono text-[10px] font-bold tracking-widest text-amber-300/85">
            <span>THINK TANK OUTPUTS</span>
            <span>$0 / MO</span>
          </div>

          <!-- 成果 1：政策脈絡神經網絡 -->
          <a
            href="/policy-map"
            data-stream-node="out-0"
            data-stage="3"
            data-anchor-side="left"
            class="stream-node block rounded-xl border border-amber-400/30 bg-[#081F17]/90 px-3.5 py-2.5 backdrop-blur-sm transition duration-200 hover:border-amber-300"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-serif text-xs font-bold text-white">1. 政策脈絡神經網絡</span>
              <svg class="h-4 w-8 text-amber-300 shrink-0" viewBox="0 0 36 16" fill="none" aria-hidden="true">
                <line x1="5" y1="11" x2="18" y2="4" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.2" />
                <line x1="18" y1="4" x2="31" y2="11" stroke="#34D399" stroke-opacity="0.7" stroke-width="1.2" />
                <circle cx="5" cy="11" r="2.2" fill="#34D399" />
                <circle cx="18" cy="4" r="2.5" fill="currentColor" />
                <circle cx="31" cy="11" r="2.2" fill="#34D399" />
              </svg>
            </div>
            <div id="out-relations-text" class="mt-1 font-mono text-[11px] font-semibold text-amber-300">
              {initialRelations.toLocaleString()} 條跨年關聯
            </div>
          </a>

          <!-- 成果 2：26 年趨勢與法規時間軸 -->
          <a
            href="/trends"
            data-stream-node="out-1"
            data-stage="3"
            data-anchor-side="left"
            class="stream-node block rounded-xl border border-emerald-400/30 bg-[#081F17]/90 px-3.5 py-2.5 backdrop-blur-sm transition duration-200 hover:border-emerald-300"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-serif text-xs font-bold text-white">2. {spanYears} 年趨勢與法規時間軸</span>
              <span class="font-mono text-[10px] text-emerald-300">TIMELINE</span>
            </div>
            <div id="out-span-text" class="mt-1 text-[11px] text-emerald-100/80">
              {startYear}–{endYear} 完整演進與四階段法規脈絡
            </div>
          </a>

          <!-- 成果 3：《晧哥說》專欄與候選雷達 -->
          <a
            href="/hao-talks"
            data-stream-node="out-2"
            data-stage="3"
            data-anchor-side="left"
