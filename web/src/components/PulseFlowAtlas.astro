      rightNodes.forEach((n, idx) => {
        const y = 84 + idx * 82;
        rightPos.set(n.id, { x: 670, y });
        nodeDesc.set(n.id, `${n.label}：${n.desc}`);

        const g = document.createElementNS(svgNS, 'g');
        g.setAttribute('class', 'arc-node cursor-pointer');
        g.dataset.nodeId = n.id;

        const rect = document.createElementNS(svgNS, 'rect');
        rect.setAttribute('x', '670');
        rect.setAttribute('y', String(y - 26));
        rect.setAttribute('width', '252');
        rect.setAttribute('height', '52');
        rect.setAttribute('rx', '12');
        rect.setAttribute('fill', '#0B281E');
        rect.setAttribute('stroke', '#F59E0B');
        rect.setAttribute('stroke-opacity', '0.5');
        rect.setAttribute('stroke-width', '1.5');

        const title = document.createElementNS(svgNS, 'text');
        title.setAttribute('x', '688');
        title.setAttribute('y', String(y - 3));
