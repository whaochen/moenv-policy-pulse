      arcsResetBtn?.addEventListener('click', () => highlightArcNode(null));
    }

    // 4. View 3: LOGS (CLI Telemetry + Typewriter Replay)
    const logsScreen = document.getElementById('atlas-logs-screen');
    const logsReplayBtn = document.getElementById('logs-replay-btn');
    let logsRenderedOnce = false;
    let logsTimers: number[] = [];

    function buildLogLines(): { tag: string; color: string; text: string }[] {
      return [
        { tag: '[BOOT]', color: 'text-emerald-400', text: `Taiwan Environment Observatory · Last Sync ${liveData.updatedAt}` },
        { tag: '[SYNC]', color: 'text-emerald-300', text: `MOENV MNEWS_P_01 incremental check ...... OK (${liveData.totalNews.toLocaleString()} total archived)` },
        { tag: '[LINK]', color: 'text-emerald-300', text: 'Official article URL resolver ............ MATCHED (0 homepage fallback)' },
        { tag: '[AI]  ', color: 'text-amber-300', text: 'Gemini 2.5 Flash-Lite + Rule Fallback .... READY ($0 Free Tier)' },
        { tag: '[NET] ', color: 'text-amber-300', text: `TF-IDF + gemini-embedding-001 graph ...... ${liveData.totalRelations.toLocaleString()} edges indexed` },
        { tag: '[DATA]', color: 'text-emerald-300', text: 'Yearly JSON shards + Research CSVs ....... EXPORTED (< 90 files, < 2 MiB index)' },
        { tag: '[LIVE]', color: 'text-white', text: 'Astro static build -> Cloudflare Pages ... DEPLOYED ($0/mo · STATUS OK)' },
      ];
    }

    function renderLogs(animate: boolean) {
      if (!logsScreen) return;
      logsRenderedOnce = true;
      logsTimers.forEach((t) => window.clearTimeout(t));
      logsTimers = [];
      const lines = buildLogLines();

      if (!animate || reduceMotion) {
        logsScreen.innerHTML = lines
          .map((l) => `<div><span class="font-bold ${l.color}">${l.tag}</span> <span class="text-emerald-100/90">${l.text}</span></div>`)
          .join('');
        return;
      }

      logsScreen.innerHTML = '';
      lines.forEach((l, idx) => {
        const t = window.setTimeout(() => {
          const row = document.createElement('div');
          row.innerHTML = `<span class="font-bold ${l.color}">${l.tag}</span> <span class="text-emerald-100/90">${l.text}</span>`;
          logsScreen.appendChild(row);
        }, idx * 380);
        logsTimers.push(t);
      });
    }

    logsReplayBtn?.addEventListener('click', () => renderLogs(true));

    // 5. Hydrate live real data from /data/manifest.json & /data/trends.json
    Promise.all([
      fetch('/data/manifest.json').then((r) => (r.ok ? r.json() : null)).catch(() => null),
      fetch('/data/trends.json').then((r) => (r.ok ? r.json() : null)).catch(() => null),
    ]).then(([m, tr]) => {
      if (m) {
        if (typeof m.total_news === 'number') liveData.totalNews = m.total_news;
        if (typeof m.total_relation_edges === 'number') liveData.totalRelations = m.total_relation_edges;
        if (typeof m.last_30_days_count === 'number') liveData.last30d = m.last_30_days_count;
        if (m.date_start) liveData.dateStart = m.date_start;
        if (m.date_end) liveData.dateEnd = m.date_end;
        if (m.updated_at) liveData.updatedAt = String(m.updated_at).replace('T', ' ').replace(/\+08:00$/, ' (UTC+8)');
        const sy = Number(liveData.dateStart.slice(0, 4)) || 2001;
        const ey = Number(liveData.dateEnd.slice(0, 4)) || 2026;
        liveData.yearsSpan = Math.max(1, ey - sy + 1);

        const elNews = document.getElementById('atlas-stat-news');
        const elRel = document.getElementById('atlas-stat-relations');
        const elSpan = document.getElementById('atlas-stat-span');
        const elSync = document.getElementById('atlas-header-sync');
        const elLeftTotal = document.getElementById('stream-left-total');
        const elMobTotal = document.getElementById('mob-stream-total');
        const elCoreBEdges = document.getElementById('core-b-edges');
        const elMobCoreBEdges = document.getElementById('mob-core-b-edges');
        const elOutRel = document.getElementById('out-relations-text');
        const elMobOutRel = document.getElementById('mob-out-relations');
        const elLive30 = document.getElementById('era-count-live');
        const elMobLive30 = document.getElementById('mob-era-live');

        if (elNews) elNews.textContent = `${liveData.totalNews.toLocaleString()} 篇`;
        if (elRel) elRel.textContent = `${liveData.totalRelations.toLocaleString()} 條`;
        if (elSpan) elSpan.textContent = `${sy}–${ey} (${liveData.yearsSpan} YRS)`;
        if (elSync) elSync.textContent = liveData.updatedAt;
        if (elLeftTotal) elLeftTotal.textContent = `${liveData.totalNews.toLocaleString()} 篇`;
        if (elMobTotal) elMobTotal.textContent = `${liveData.totalNews.toLocaleString()} 篇`;
        if (elCoreBEdges) elCoreBEdges.textContent = `編織 ${liveData.totalRelations.toLocaleString()} 關聯邊`;
        if (elMobCoreBEdges) elMobCoreBEdges.textContent = `Flash-Lite 摘要・embedding-001 向量・編織 ${liveData.totalRelations.toLocaleString()} 關聯邊`;
        if (elOutRel) elOutRel.textContent = `${liveData.totalRelations.toLocaleString()} 條跨年關聯`;
        if (elMobOutRel) elMobOutRel.textContent = `${liveData.totalRelations.toLocaleString()} 條`;
        if (elLive30) elLive30.textContent = `近30天 ${liveData.last30d} 篇`;
        if (elMobLive30) elMobLive30.textContent = `近30天 ${liveData.last30d} 篇`;
      }

      if (tr && Array.isArray(tr.yearly_totals)) {
        const sumRange = (minY: number, maxY: number) =>
          tr.yearly_totals.reduce((acc: number, row: { year: string; count: number }) => {
            const y = Number(row.year);
            return y >= minY && y <= maxY ? acc + (row.count || 0) : acc;
          }, 0);
        liveData.eras = [
          sumRange(2001, 2010),
          sumRange(2011, 2015),
          sumRange(2016, 2020),
          sumRange(2021, 2026),
        ];
        liveData.eras.forEach((cnt, idx) => {
          const el = document.getElementById(`era-count-${idx + 1}`);
          const mobEl = document.getElementById(`mob-era-${idx + 1}`);
          if (el) el.textContent = `${cnt.toLocaleString()} 篇`;
          if (mobEl) mobEl.textContent = `${cnt.toLocaleString()} 篇`;
        });
      }

      computeStreamGeometry();
      renderStage(activeStage);
      if (logsRenderedOnce) renderLogs(false);
    });

    renderStage(0);
    computeStreamGeometry();
    ensureParticleLoop();
    updateCruiseBtn();
    if (cruiseOn) startCruise();
  }
</script>
