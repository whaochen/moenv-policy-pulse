<style>
  @keyframes atlas-ping-kf {
    0% { transform: scale(1); opacity: 0.75; }
    75%, 100% { transform: scale(2.1); opacity: 0; }
  }
  @keyframes atlas-spin-kf {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .atlas-ping {
    animation: atlas-ping-kf 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .atlas-spin-slow {
    animation: atlas-spin-kf 24s linear infinite;
  }
  .atlas-spin-reverse {
    animation: atlas-spin-kf 18s linear infinite reverse;
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-ping,
    .atlas-spin-slow,
    .atlas-spin-reverse {
      animation: none;
    }
  }
</style>

<script>
  const root = document.getElementById('hao-pulse-flow-atlas');
  if (root) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const liveData = {
      totalNews: Number((document.getElementById('atlas-stat-news')?.textContent || '11511').replace(/[^\d]/g, '')) || 11511,
      totalRelations: Number((document.getElementById('atlas-stat-relations')?.textContent || '56250').replace(/[^\d]/g, '')) || 56250,
      dateStart: '2001-01-01',
      dateEnd: '2026-11-25',
      updatedAt: document.getElementById('atlas-header-sync')?.textContent || '',
      yearsSpan: 26,
      last30d: Number((document.getElementById('era-count-live')?.textContent || '0').replace(/[^\d]/g, '')) || 0,
      eras: [
        Number((document.getElementById('era-count-1')?.textContent || '0').replace(/[^\d]/g, '')) || 0,
        Number((document.getElementById('era-count-2')?.textContent || '0').replace(/[^\d]/g, '')) || 0,
        Number((document.getElementById('era-count-3')?.textContent || '0').replace(/[^\d]/g, '')) || 0,
        Number((document.getElementById('era-count-4')?.textContent || '0').replace(/[^\d]/g, '')) || 0,
      ],
    };

    const stages = [
      {
        code: 'STAGE 01 · 海量匯入',
        short: 'INGESTION',
        scaleFn: () => `${liveData.totalNews.toLocaleString()} 篇官方新聞`,
        titleFn: () => `百川匯海：無痛收錄 ${liveData.dateStart.slice(0, 4)}–${liveData.dateEnd.slice(0, 4)} 共 ${liveData.totalNews.toLocaleString()} 篇官方新聞`,
        descFn: () => '結合環境部 26 年歷史歸檔與 MNEWS_P_01 開放資料即時增量，每日 4 次自動入庫，完整保留台灣環境治理全貌。',
      },
      {
        code: 'STAGE 02 · 系統工程',
        short: 'SYSTEM ENGINE',
        scaleFn: () => '每日 4 次自動排程 · 零幻覺',
        titleFn: () => '系統化清洗與索引：雙重指紋去重 × 單篇原網址精準配對',
        descFn: () => '由 GitHub Actions 在台灣時間 06:17、11:17、16:17、21:17 自動執行清洗、20 大議題分類與完整性驗證，絕不以首頁充數。',
      },
      {
        code: 'STAGE 03 · AI 雙模型輔助',
        short: 'AI SEMANTIC CORE',
        scaleFn: () => `${liveData.totalRelations.toLocaleString()} 條語意關聯邊`,
        titleFn: () => `AI 語意雙模型煉金：Gemini 2.5 Flash-Lite × gemini-embedding-001 × TF-IDF`,
        descFn: () => `結合免費層雙模型與環保專有名詞詞典，將原始新聞提煉為 ${liveData.totalRelations.toLocaleString()} 條前世今生脈絡，遇限流自動無縫降級。`,
      },
      {
        code: 'STAGE 04 · 智庫規模產出',
        short: 'THINK TANK OUTPUTS',
        scaleFn: () => '4 大公開成果 · 永久 $0 / 月',
        titleFn: () => '人類把脈與規模化交付：Obsidian 晧哥把脈 → 永久零元智庫網站',
        descFn: () => 'AI 梳理萬篇脈絡後，由晧哥在 Obsidian 把脈撰寫《晧哥說》，最終以 26 個年度分片發布至全球邊緣節點。',
      },
    ];

    let activeStage = 0;
    let hoveredNodeKey: string | null = null;
    let cruiseOn = !reduceMotion;
    let cruiseTimer: number | null = null;
    let currentView = 'flows';
    let inViewport = true;

    const flowStepEl = document.getElementById('flow-card-step');
    const flowScaleEl = document.getElementById('flow-card-scale');
    const flowTitleEl = document.getElementById('flow-card-title');
    const flowDescEl = document.getElementById('flow-card-desc');
    const flowIndicatorEl = document.getElementById('flow-cruise-indicator');
    const cruiseBtn = document.getElementById('atlas-cruise-btn');

    function renderStage(idx: number) {
      activeStage = idx;
      const st = stages[idx];
      if (!st) return;

      if (flowStepEl) flowStepEl.textContent = st.code;
      if (flowScaleEl) flowScaleEl.textContent = st.scaleFn();
      if (flowTitleEl) flowTitleEl.textContent = st.titleFn();
      if (flowDescEl) flowDescEl.textContent = st.descFn();
      if (flowIndicatorEl) flowIndicatorEl.textContent = `0${idx + 1} / 04 · ${st.short}`;

      root.querySelectorAll<HTMLButtonElement>('.stage-pill-btn').forEach((b) => {
        const isCurrent = Number(b.dataset.stageBtn) === idx;
        b.classList.toggle('border-amber-400/70', isCurrent);
        b.classList.toggle('bg-amber-500/20', isCurrent);
        b.classList.toggle('text-amber-200', isCurrent);
        b.classList.toggle('shadow-[0_0_12px_rgba(245,158,11,0.22)]', isCurrent);
        b.classList.toggle('border-emerald-500/25', !isCurrent);
        b.classList.toggle('bg-black/25', !isCurrent);
        b.classList.toggle('text-emerald-200/70', !isCurrent);
      });

      applyStreamHighlight();
    }

    // --- 三段式 SVG 流道 + Canvas 粒子引擎 ---
    const wrap = document.getElementById('stream-canvas-wrap');
    const beamsLayer = document.getElementById('stream-beams-layer');
    const canvas = document.getElementById('stream-particles-canvas') as HTMLCanvasElement | null;
    const ctx = canvas ? canvas.getContext('2d') : null;

    interface CubicPath {
      id: string;
      stage: number;
      fromKey: string;
      toKey: string;
      x0: number; y0: number;
      cx1: number; cy1: number;
      cx2: number; cy2: number;
      x1: number; y1: number;
      width: number;
      color: string;
      dashed?: boolean;
    }

    interface Particle {
      pathIdx: number;
      t: number;
      speed: number;
      size: number;
      alpha: number;
    }

    let streamPaths: CubicPath[] = [];
    let particles: Particle[] = [];

    function getAnchor(key: string, side: 'left' | 'right' | 'top' | 'bottom'): { x: number; y: number } | null {
      if (!wrap) return null;
      const el = wrap.querySelector<HTMLElement>(`[data-stream-node="${key}"]`);
      if (!el) return null;
      const wr = wrap.getBoundingClientRect();
      const er = el.getBoundingClientRect();
      if (wr.width === 0 || er.width === 0) return null;
      const cx = er.left - wr.left + er.width / 2;
      const cy = er.top - wr.top + er.height / 2;
      if (side === 'left') return { x: er.left - wr.left, y: cy };
      if (side === 'right') return { x: er.right - wr.left, y: cy };
      if (side === 'top') return { x: cx, y: er.top - wr.top };
      return { x: cx, y: er.bottom - wr.top };
    }

    function cubicPoint(p: CubicPath, t: number): { x: number; y: number } {
      const u = 1 - t;
      const tt = t * t;
      const uu = u * u;
      const uuu = uu * u;
      const ttt = tt * t;
      return {
        x: uuu * p.x0 + 3 * uu * t * p.cx1 + 3 * u * tt * p.cx2 + ttt * p.x1,
        y: uuu * p.y0 + 3 * uu * t * p.cy1 + 3 * u * tt * p.cy2 + ttt * p.y1,
      };
    }

    function computeStreamGeometry() {
      if (!wrap || !beamsLayer || !canvas) return;
      const wr = wrap.getBoundingClientRect();
      if (wr.width === 0 || wr.height === 0) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(wr.width * dpr);
      canvas.height = Math.round(wr.height * dpr);
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const svg = document.getElementById('stream-beams-svg');
      svg?.setAttribute('viewBox', `0 0 ${wr.width} ${wr.height}`);

      const coreALeft = getAnchor('core-a', 'left');
      const coreARight = getAnchor('core-a', 'right');
      const coreABot = getAnchor('core-a', 'bottom');
      const coreBLeft = getAnchor('core-b', 'left');
      const coreBRight = getAnchor('core-b', 'right');
      const coreBTop = getAnchor('core-b', 'top');
      const coreBBot = getAnchor('core-b', 'bottom');
      const humanTop = getAnchor('core-human', 'top');
      const humanRight = getAnchor('core-human', 'right');

      if (!coreALeft || !coreBLeft || !coreBRight || !coreARight) return;

      const maxEra = Math.max(1, ...liveData.eras);
      const nextPaths: CubicPath[] = [];

      // 左段 5 條匯流通道（前 3 條導向核心 A，後 2 條導向核心 A/B 交會）
      for (let i = 0; i < 5; i++) {
        const start = getAnchor(`src-${i}`, 'right');
        if (!start) continue;
        const target = i < 3 ? coreALeft : coreBLeft;
        const dx = (target.x - start.x) * 0.55;
        const ratio = i < 4 ? (liveData.eras[i] || 500) / maxEra : 0.65;
        const width = 1.6 + ratio * 2.4;
        nextPaths.push({
          id: `in-${i}`,
          stage: 0,
          fromKey: `src-${i}`,
          toKey: i < 3 ? 'core-a' : 'core-b',
          x0: start.x, y0: start.y,
          cx1: start.x + dx, cy1: start.y,
          cx2: target.x - dx, cy2: target.y + (i - 2) * 4,
          x1: target.x, y1: target.y + (i - 2) * 4,
          width,
          color: i === 4 ? '#6EE7B7' : '#34D399',
        });
      }

      // 中段 核心 A -> 核心 B 垂直串聯能量束
      if (coreABot && coreBTop) {
        nextPaths.push({
          id: 'core-a-b',
          stage: 1,
          fromKey: 'core-a',
          toKey: 'core-b',
          x0: coreABot.x, y0: coreABot.y,
          cx1: coreABot.x, cy1: (coreABot.y + coreBTop.y) / 2,
          cx2: coreBTop.x, cy2: (coreABot.y + coreBTop.y) / 2,
          x1: coreBTop.x, y1: coreBTop.y,
          width: 2.6,
          color: '#34D399',
        });
      }

      // 中段 核心 B -> 下方 Obsidian 晧哥把脈 暖金虛線光束
      if (coreBBot && humanTop) {
        nextPaths.push({
          id: 'core-b-human',
          stage: 3,
          fromKey: 'core-b',
          toKey: 'core-human',
          x0: coreBBot.x, y0: coreBBot.y,
          cx1: coreBBot.x, cy1: (coreBBot.y + humanTop.y) / 2,
          cx2: humanTop.x, cy2: (coreBBot.y + humanTop.y) / 2,
          x1: humanTop.x, y1: humanTop.y,
          width: 2.0,
          color: '#F59E0B',
          dashed: true,
        });
      }

      // 右段 4 條智庫成果輸出束
      const outputStarts = [coreBRight, coreARight, humanRight || coreBRight, coreBRight];
      const outputColors = ['#F59E0B', '#34D399', '#FBBF24', '#34D399'];
      const outputFrom = ['core-b', 'core-a', 'core-human', 'core-b'];

      for (let j = 0; j < 4; j++) {
        const start = outputStarts[j];
        const end = getAnchor(`out-${j}`, 'left');
        if (!start || !end) continue;
        const dx = (end.x - start.x) * 0.52;
        nextPaths.push({
          id: `out-${j}`,
          stage: 3,
          fromKey: outputFrom[j],
          toKey: `out-${j}`,
          x0: start.x, y0: start.y,
          cx1: start.x + dx, cy1: start.y,
          cx2: end.x - dx, cy2: end.y,
          x1: end.x, y1: end.y,
          width: 2.4,
          color: outputColors[j],
        });
      }

      streamPaths = nextPaths;

      // 繪製底層 SVG 貝茲流道
      beamsLayer.innerHTML = '';
      for (const p of streamPaths) {
        const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        pathEl.setAttribute('d', `M ${p.x0} ${p.y0} C ${p.cx1} ${p.cy1}, ${p.cx2} ${p.cy2}, ${p.x1} ${p.y1}`);
        pathEl.setAttribute('stroke', p.color);
        pathEl.setAttribute('stroke-width', String(p.width));
        pathEl.setAttribute('stroke-linecap', 'round');
        if (p.dashed) pathEl.setAttribute('stroke-dasharray', '5 5');
        pathEl.dataset.pathId = p.id;
        pathEl.dataset.stage = String(p.stage);
        pathEl.dataset.fromKey = p.fromKey;
        pathEl.dataset.toKey = p.toKey;
        beamsLayer.appendChild(pathEl);
      }

      // 初始化 75+ 顆高密度粒子（左段源頭密集湧入，呈現萬篇規模感）
      if (particles.length === 0 && streamPaths.length > 0) {
        const nextParticles: Particle[] = [];
        streamPaths.forEach((p, idx) => {
          const count = p.id.startsWith('in-') ? 10 : p.id.startsWith('out-') ? 6 : 4;
          for (let k = 0; k < count; k++) {
            nextParticles.push({
              pathIdx: idx,
              t: (k / count + Math.random() * 0.12) % 1,
              speed: (p.id.startsWith('in-') ? 0.0042 : 0.0048) + Math.random() * 0.0022,
              size: p.id.startsWith('in-') ? 1.5 + Math.random() * 1.4 : 1.8 + Math.random() * 1.5,
              alpha: 0.65 + Math.random() * 0.35,
            });
          }
        });
        particles = nextParticles;
      }

      applyStreamHighlight();
    }

    function isPathHighlighted(p: { stage: number; fromKey: string; toKey: string }): boolean {
      if (hoveredNodeKey) {
        return p.fromKey === hoveredNodeKey || p.toKey === hoveredNodeKey;
      }
      if (activeStage === 1) return p.toKey === 'core-a' || p.fromKey === 'core-a';
      if (activeStage === 2) return p.toKey === 'core-b' || p.fromKey === 'core-b';
      return p.stage === activeStage;
    }

    function isNodeHighlighted(key: string, nodeStage: number): boolean {
      if (hoveredNodeKey) {
        if (key === hoveredNodeKey) return true;
        return streamPaths.some(
          (p) => (p.fromKey === hoveredNodeKey && p.toKey === key) || (p.toKey === hoveredNodeKey && p.fromKey === key)
        );
      }
      return nodeStage === activeStage;
    }

    function applyStreamHighlight() {
      if (beamsLayer) {
        beamsLayer.querySelectorAll<SVGPathElement>('path').forEach((el) => {
          const info = {
            stage: Number(el.dataset.stage || '0'),
            fromKey: el.dataset.fromKey || '',
            toKey: el.dataset.toKey || '',
          };
          const hi = isPathHighlighted(info);
          el.setAttribute('opacity', hi ? '0.92' : '0.22');
          if (hi) el.setAttribute('filter', 'url(#stream-beam-glow)');
          else el.removeAttribute('filter');
        });
      }

      wrap?.querySelectorAll<HTMLElement>('.stream-node').forEach((node) => {
        const key = node.dataset.streamNode || '';
        const st = Number(node.dataset.stage || '0');
        const hi = isNodeHighlighted(key, st);
        node.style.opacity = hi ? '1' : '0.45';
        node.style.transform = hi && key === hoveredNodeKey ? 'translateY(-1px)' : '';
      });
    }

    // 60FPS Particle Loop
    let rafId: number | null = null;
    function tickParticles() {
      if (!ctx || !canvas || !wrap || currentView !== 'flows' || !inViewport || reduceMotion) {
        rafId = null;
        return;
      }

      const wr = wrap.getBoundingClientRect();
      ctx.clearRect(0, 0, wr.width, wr.height);

      for (const pt of particles) {
        const p = streamPaths[pt.pathIdx];
        if (!p) continue;
        const hi = isPathHighlighted(p);
        pt.t = (pt.t + pt.speed * (hi ? 1.55 : 0.8)) % 1;

        const pos = cubicPoint(p, pt.t);
        const tailPos = cubicPoint(p, Math.max(0, pt.t - 0.035));
        const alpha = pt.alpha * (hi ? 1 : 0.24);

        // 輕微拖尾光束
        ctx.beginPath();
        ctx.moveTo(tailPos.x, tailPos.y);
        ctx.lineTo(pos.x, pos.y);
        ctx.strokeStyle = p.color;
        ctx.globalAlpha = alpha * 0.55;
        ctx.lineWidth = pt.size * 1.1;
        ctx.lineCap = 'round';
        ctx.stroke();

        // 粒子核心點
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, pt.size, 0, Math.PI * 2);
        ctx.fillStyle = hi ? '#FFFFFF' : p.color;
        ctx.globalAlpha = alpha;
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      rafId = window.requestAnimationFrame(tickParticles);
    }

    function ensureParticleLoop() {
      if (!reduceMotion && currentView === 'flows' && inViewport && rafId === null && wrap && wrap.offsetParent !== null) {
        rafId = window.requestAnimationFrame(tickParticles);
      }
    }

    if (wrap) {
      const ro = new ResizeObserver(() => {
        computeStreamGeometry();
        ensureParticleLoop();
      });
      ro.observe(wrap);
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          inViewport = entries.some((e) => e.isIntersecting);
          if (inViewport) ensureParticleLoop();
        },
        { threshold: 0.05 }
      );
      io.observe(root);
    }

    // 巡航與互動控制
    function updateCruiseBtn() {
      if (!cruiseBtn) return;
      cruiseBtn.textContent = cruiseOn ? '⏸ 暫停巡航' : '▶ 自動巡航';
    }

    function stopCruise() {
      cruiseOn = false;
      if (cruiseTimer !== null) {
        window.clearInterval(cruiseTimer);
        cruiseTimer = null;
      }
      updateCruiseBtn();
    }

    function startCruise() {
      stopCruise();
      hoveredNodeKey = null;
      cruiseOn = true;
      updateCruiseBtn();
      cruiseTimer = window.setInterval(() => {
        renderStage((activeStage + 1) % stages.length);
      }, 4200);
    }

    cruiseBtn?.addEventListener('click', () => {
      if (cruiseOn) stopCruise();
      else startCruise();
    });

    root.querySelectorAll<HTMLButtonElement>('.stage-pill-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        stopCruise();
        hoveredNodeKey = null;
        renderStage(Number(btn.dataset.stageBtn || '0'));
      });
    });

    root.querySelectorAll<HTMLElement>('.stream-node').forEach((node) => {
      const key = node.dataset.streamNode || '';
      const st = Number(node.dataset.stage || '0');
      node.addEventListener('mouseenter', () => {
        stopCruise();
        hoveredNodeKey = key;
        renderStage(st);
      });
      node.addEventListener('mouseleave', () => {
        hoveredNodeKey = null;
        applyStreamHighlight();
      });
    });

    // View Switching (FLOWS / ARCS / LOGS)
    const viewBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.atlas-view-btn'));
    const panels: Record<string, HTMLElement | null> = {
      flows: document.getElementById('atlas-panel-flows'),
      arcs: document.getElementById('atlas-panel-arcs'),
      logs: document.getElementById('atlas-panel-logs'),
    };

    function switchView(view: string) {
      currentView = view;
      viewBtns.forEach((b) => {
        const active = b.dataset.atlasView === view;
        b.setAttribute('aria-selected', String(active));
        b.classList.toggle('bg-emerald-500/25', active);
        b.classList.toggle('font-bold', active);
        b.classList.toggle('text-emerald-200', active);
        b.classList.toggle('shadow-[0_0_12px_rgba(16,185,129,0.25)]', active);
        b.classList.toggle('text-emerald-200/60', !active);
        b.classList.toggle('font-medium', !active);
      });
      Object.entries(panels).forEach(([k, p]) => p?.classList.toggle('hidden', k !== view));
      if (view === 'flows') {
        computeStreamGeometry();
        ensureParticleLoop();
      }
      if (view === 'logs' && !logsRenderedOnce) {
        renderLogs(false);
      }
    }

    viewBtns.forEach((btn) => {
      btn.addEventListener('click', () => switchView(btn.dataset.atlasView || 'flows'));
    });

    // 3. Build View 2: ARCS (7 Left Tools × 4 Right Governance Modules)
    const leftNodes = [
      { id: 'L0', label: 'MOENV MNEWS_P_01', desc: '環境部開放資料平臺每日提供最新新聞原料，並搭配單篇原網址自動配對。' },
      { id: 'L1', label: 'GitHub Actions', desc: '每日台灣時間 06:17、11:17、16:17、21:17 自動在雲端執行抓取、關聯運算、資料校驗與提交。' },
      { id: 'L2', label: 'Gemini 2.5 Flash-Lite', desc: 'Google AI Studio 免費層模型，強化每日新增新聞的重點摘要與政策標籤，遇限流自動降級。' },
      { id: 'L3', label: 'gemini-embedding-001', desc: '類神經語意嵌入向量，捕捉法規與政策間的深層語意連結，支援增量快取。' },
      { id: 'L4', label: 'TF-IDF + Jieba', desc: '掛載 20 大議題同義詞與環保法規詞典，10 秒內完成全站萬餘篇餘弦相似度計算。' },
      { id: 'L5', label: 'Obsidian Git', desc: '讓晧哥在純本機四層知識庫撰寫《晧哥說》，一鍵 Commit & Push 觸發上線。' },
      { id: 'L6', label: 'Google Antigravity', desc: '與 Gemini 架構設計協作完成工程實作、自動化測試、UI 重塑與部署驗證。' },
    ];

    const rightNodes = [
      { id: 'R0', label: 'DATA', sub: '原文擷取 · 單篇配對 · 雙重去重', desc: 'DATA 模組負責每日增量擷取、精準配對環境部單篇原文網址，並以雙重指紋守護萬餘筆歸檔。' },
      { id: 'R1', label: 'MEMORY', sub: '26 年語料 · 56,250+ 關聯 · 四層筆記', desc: 'MEMORY 模組串連 26 年全量語料庫與超過 56,000 條跨年關聯邊，並同步寫入 Obsidian 四層知識結構。' },
      { id: 'R2', label: 'RULES', sub: '零幻覺統計 · 免費降級 · 草稿閘門', desc: 'RULES 模組以純程式確保統計零幻覺、API 限流自動降級不中斷，並嚴格攔截所有 draft 草稿。' },
      { id: 'R3', label: 'DELIVERY', sub: '年度分片 JSON · 神經網 · 學術下載', desc: 'DELIVERY 模組將全量資料切分為年度輕量分片，驅動互動神經網絡圖、全量檢索與研究級 CSV 下載。' },
    ];

    const arcEdges: [string, string][] = [
      ['L0', 'R0'], ['L0', 'R1'],
      ['L1', 'R0'], ['L1', 'R2'], ['L1', 'R3'],
      ['L2', 'R1'], ['L2', 'R2'],
      ['L3', 'R1'], ['L3', 'R3'],
      ['L4', 'R1'], ['L4', 'R2'], ['L4', 'R3'],
      ['L5', 'R1'], ['L5', 'R2'], ['L5', 'R3'],
      ['L6', 'R0'], ['L6', 'R2'], ['L6', 'R3'],
    ];

    const svgNS = 'http://www.w3.org/2000/svg';
    const linksLayer = document.getElementById('arcs-links-layer');
    const leftLayer = document.getElementById('arcs-left-layer');
    const rightLayer = document.getElementById('arcs-right-layer');
    const explainText = document.getElementById('arcs-explain-text');
    const arcsResetBtn = document.getElementById('arcs-reset-btn');

    if (linksLayer && leftLayer && rightLayer) {
      const leftPos = new Map<string, { x: number; y: number }>();
      const rightPos = new Map<string, { x: number; y: number }>();
      const nodeDesc = new Map<string, string>();

      leftNodes.forEach((n, idx) => {
        const y = 66 + idx * 49;
        leftPos.set(n.id, { x: 250, y });
